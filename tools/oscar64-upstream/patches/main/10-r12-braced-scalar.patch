 autotest/scalarbraceinitcpp.cpp |  50 ++++++++++++++
 autotest/scalarbraceinittest.c  | 116 ++++++++++++++++++++++++++++++++
 oscar64/Parser.cpp              |  26 +++++++
 4 files changed, 198 insertions(+)
 create mode 100644 autotest/scalarbraceinitcpp.cpp
 create mode 100644 autotest/scalarbraceinittest.c

diff --git a/autotest/autotest.bat b/autotest/autotest.bat
