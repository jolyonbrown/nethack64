 autotest/nestedternaryjumptest.c | 71 ++++++++++++++++++++++++++++++++
 autotest/ternaryexitblocktest.c  | 49 ++++++++++++++++++++++
 oscar64/NativeCodeGenerator.cpp  | 31 +++++++++++++-
 4 files changed, 155 insertions(+), 2 deletions(-)
 create mode 100644 autotest/nestedternaryjumptest.c
 create mode 100644 autotest/ternaryexitblocktest.c

diff --git a/autotest/autotest.bat b/autotest/autotest.bat
index ff4124e..dface9d 100644
--- a/autotest/autotest.bat
+++ b/autotest/autotest.bat
@@ -462,6 +462,12 @@ rem @echo off
 @call :test mixedwidthternary.c
 @if %errorlevel% neq 0 goto :error
 
