diff --git a/autotest/nestedternaryjumptest.c b/autotest/nestedternaryjumptest.c
new file mode 100644
index 0000000..d2452d4
--- /dev/null
+++ b/autotest/nestedternaryjumptest.c
@@ -0,0 +1,71 @@
+#include <assert.h>
+
+// A nested conditional with int operands.  The inner "d ? 4 : 5" becomes
+// two one-instruction blocks that BranchAccuAlternativeElimination turns
+// into "LDA #1 / EOR #1 / ORA #4" followed by a jump to the common store.
+// MergeBasicBlocks then appended the "ORA #4" block to its single
+// predecessor, but copied the register data set of the block *after* it,
+// so the trailing JMP was emitted as a never taken BEQ and the function
+// fell off its end.
+//
+// f, fv and fs reproduce the bug (f and fv with -n and -n -O0, fs with
+// -n -O0).  fl and fp are controls that never failed; fp(&a, &b) also
+// takes the addresses of a and b, which keeps f and fv on full 16-bit
+// compares at -O2, -Os and -O3, where the bug then shows as well.
+
+__noinline int f(int c, int d)
+{
+	return c ? 3 : (d ? 4 : 5);
+}
+
+__noinline unsigned long fl(unsigned long c, unsigned long d)
+{
+	return c ? 3 : (d ? 4 : 5);
+}
+
+__noinline int fp(int * c, int * d)
+{
+	return *c ? 3 : (*d ? 4 : 5);
+}
+
+__noinline int fv(volatile int c, volatile int d)
+{
+	return c ? 3 : (d ? 4 : 5);
+}
+
+static int fs(int c, int d)
+{
+	return c ? 3 : (d ? 4 : 5);
+}
+
+int a = 0, b = 1;
+
+int main(void)
+{
+	assert(f(a, b) == 4);
+	assert(f(a, a) == 5);
+	assert(f(b, a) == 3);
+	assert(f(b, b) == 3);
+
+	assert(fl(a, b) == 4);
+	assert(fl(a, a) == 5);
+	assert(fl(b, a) == 3);
+	assert(fl(b, b) == 3);
+
+	assert(fp(&a, &b) == 4);
+	assert(fp(&a, &a) == 5);
+	assert(fp(&b, &a) == 3);
+	assert(fp(&b, &b) == 3);
+
+	assert(fv(a, b) == 4);
+	assert(fv(a, a) == 5);
+	assert(fv(b, a) == 3);
+	assert(fv(b, b) == 3);
+
+	assert(fs(0, 1) == 4);
+	assert(fs(0, 0) == 5);
+	assert(fs(1, 0) == 3);
+	assert(fs(1, 1) == 3);
+
+	return 0;
+}
diff --git a/autotest/ternaryexitblocktest.c b/autotest/ternaryexitblocktest.c
new file mode 100644
index 0000000..f233b1a
--- /dev/null
+++ b/autotest/ternaryexitblocktest.c
@@ -0,0 +1,49 @@
+#include <assert.h>
+
+// Functions whose exit block holds a conditional that is still a
+// CMP/LDA #0/ADC #$ff/AND/EOR value select when ExpandADCToBranch turns it
+// into a branch and splits the block.  The remaining instructions,
+// including the temporary RTS, move to a new block behind one arm of the
+// branch, but the exit block role was handed to that arm.  The RTS was
+// then removed from the wrong block and the function returned early
+// without its stores, until 83e805b, which made the final MergeBasicBlocks
+// dereference a null successor instead, so the compiler crashed.
+//
+// For f the select survives to that point with -n -O0 only; for g, with
+// the int select, it survives at every optimization level, so g fails
+// with -n at every level.
+
+unsigned char ga, gb;
+int gi;
+
+__noinline unsigned char f(unsigned char p0, unsigned char p1)
+{
+	unsigned char r = p1;
+	if (r) ga = 8; else ga = 5;
+	gb = p0 ? 16 : 1;
+	return r;
+}
+
+__noinline void g(unsigned char p0, unsigned char p1)
+{
+	if (p0) ga = 2; else ga = 4;
+	gb = (p0 >> 2) & 1;
+	gi = p1 ? 242 : -127;
+}
+
+unsigned char z = 0, o = 1, v = 4;
+
+int main(void)
+{
+	assert(f(z, o) == 1 && ga == 8 && gb == 1);
+	assert(f(o, z) == 0 && ga == 5 && gb == 16);
+	assert(f(o, o) == 1 && ga == 8 && gb == 16);
+	assert(f(z, z) == 0 && ga == 5 && gb == 1);
+
+	g(z, z); assert(ga == 4 && gb == 0 && gi == -127);
+	g(o, o); assert(ga == 2 && gb == 0 && gi == 242);
+	g(v, z); assert(ga == 2 && gb == 1 && gi == -127);
+	g(z, v); assert(ga == 4 && gb == 0 && gi == 242);
+
+	return 0;
+}
diff --git a/oscar64/NativeCodeGenerator.cpp b/oscar64/NativeCodeGenerator.cpp
index bac77d0..22916dc 100644
--- a/oscar64/NativeCodeGenerator.cpp
+++ b/oscar64/NativeCodeGenerator.cpp
@@ -17081,8 +17081,8 @@ bool NativeCodeBasicBlock::MergeBasicBlocks(void)
 					mIns.Push(mTrueJump->mIns[i]);
 				mBranch = mTrueJump->mBranch;
 				mFalseJump = mTrueJump->mFalseJump;
-				mTrueJump = mTrueJump->mTrueJump;
 				mNDataSet = mTrueJump->mNDataSet;
+				mTrueJump = mTrueJump->mTrueJump;
 				changed = true;
 			}
 
@@ -26632,8 +26632,34 @@ bool NativeCodeBasicBlock::ExpandADCToBranch(void)
 
 		if (changed && this == mProc->mExitBlock && mTrueJump)
 		{
+			// The trailing instructions, including the temporary RTS, have been
+			// moved into a new block behind the new branch.  That block took
+			// over the missing successors of the exit block, so hand the exit
+			// block role to the first reachable block without successors
+
+			NativeCodeBasicBlock* eblock = nullptr;
+			ExpandingArray<NativeCodeBasicBlock*>	eblocks;
+			eblocks.Push(mTrueJump);
+			if (mFalseJump)
+				eblocks.Push(mFalseJump);
+			for (int i = 0; i < eblocks.Size() && i < 16 && !eblock; i++)
+			{
+				NativeCodeBasicBlock* b = eblocks[i];
+				if (!b->mTrueJump && !b->mFalseJump)
+					eblock = b;
+				else
+				{
+					if (b->mTrueJump && b->mTrueJump != this && !eblocks.Contains(b->mTrueJump))
+						eblocks.Push(b->mTrueJump);
+					if (b->mFalseJump && b->mFalseJump != this && !eblocks.Contains(b->mFalseJump))
+						eblocks.Push(b->mFalseJump);
+				}
+			}
+			if (!eblock)
+				eblock = mTrueJump;
+
 			mLocked = false;
-			mProc->mExitBlock = mTrueJump;
+			mProc->mExitBlock = eblock;
 			mProc->mExitBlock->mLocked = true;
 		}
 
@@ -73170,6 +73196,7 @@ void NativeCodeProcedure::Compile(InterCodeProcedure* proc)
 
 	// Remove temporary RTS
 
+	assert(mExitBlock->mIns.Size() > 0 && mExitBlock->mIns.Last().mType == ASMIT_RTS);
 	mExitBlock->mIns.Pop();
 
 	int frameSpace = tempSave;
