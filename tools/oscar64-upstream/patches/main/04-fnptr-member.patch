diff --git a/autotest/funcptrmemberaddrtest.c b/autotest/funcptrmemberaddrtest.c
new file mode 100644
index 0000000..20554d1
--- /dev/null
+++ b/autotest/funcptrmemberaddrtest.c
@@ -0,0 +1,180 @@
+#include <assert.h>
+
+// Function pointer members of global struct variables, cases not run with -Ofp:
+// the address of a member or of an element of an array member is a constant,
+// usable in a static initializer, multi dimensional arrays of function
+// pointers (-Ofp tracks only one array level), and members of anonymous
+// unions (not tracked by -Ofp)
+
+int add1(int x)
+{
+	return x + 1;
+}
+
+int add2(int x)
+{
+	return x + 2;
+}
+
+struct procs
+{
+	int		pad;
+	int		(*fn)(int x);
+	int		(*arr[2])(int x);
+};
+
+struct procs		gp;
+static struct procs	sp;
+
+struct nested
+{
+	char			c;
+	struct procs	p;
+}	np;
+
+struct t2
+{
+	int		pad;
+	int		(*fn[2][2])(int x);
+}	w2;
+
+int	(*tab[2][2])(int x);
+
+// a call through a member of an anonymous union, or through a variable index
+// into a two dimensional array member, must be registered as a call: the
+// caller keeps locals live across it, and the callee uses a helper with its
+// own locals. The operands stay small so that no intermediate result
+// overflows an int
+struct procsu
+{
+	int		pad;
+	union
+	{
+		int		(*fn)(int a, int b);
+		void *	vp;
+	};
+}	cwu;
+
+struct procs2
+{
+	int		pad;
+	int		(*fn[2][2])(int a, int b);
+}	cw2;
+
+__noinline int helper(int a, int b, int c, int d)
+{
+	int t[4];
+	t[0] = a * 3; t[1] = b * 5; t[2] = c * 7; t[3] = d * 11;
+	return t[0] + t[1] + t[2] + t[3];
+}
+
+__noinline int callee(int a, int b)
+{
+	int u = a + 10, v = b + 20, s = u * v;
+	return helper(u, v, s, a ^ b) + s;
+}
+
+__noinline int caller_union(int x, int y)
+{
+	int l1 = x * 13, l2 = y * 17, l3 = x * y + 19, l4 = x - y;
+	int r = cwu.fn(x, y);
+	return l1 + l2 + l3 + l4 + r;
+}
+
+__noinline int caller_2d(int i, int x, int y)
+{
+	int l1 = x * 13, l2 = y * 17, l3 = x * y + 19, l4 = x - y;
+	int r = cw2.fn[i][1 - i](x, y);
+	return l1 + l2 + l3 + l4 + r;
+}
+
+int ref_caller(int x, int y)
+{
+	int l1 = x * 13, l2 = y * 17, l3 = x * y + 19, l4 = x - y;
+	int u = x + 10, v = y + 20, s = u * v;
+	int r = (u * 3 + v * 5 + s * 7 + (x ^ y) * 11) + s;
+	return l1 + l2 + l3 + l4 + r;
+}
+
+int	(**gpp)(int) = &gp.fn;
+int	(**spp)(int) = &sp.fn;
+int	(**npp)(int) = &np.p.fn;
+
+int	(**ap0)(int) = gp.arr;
+int	(**ap1)(int) = &gp.arr[1];
+int	(**ap2)(int) = sp.arr + 1;
+int	(*(*app)[2])(int) = &gp.arr;
+int	(**ap10)(int) = &w2.fn[1][0];
+
+int main(void)
+{
+	gp.fn = add1;
+	sp.fn = add2;
+	np.p.fn = add2;
+
+	assert((*gpp)(1) == 2);
+	assert((*spp)(1) == 3);
+	assert((*npp)(1) == 3);
+
+	assert(gpp == &gp.fn);
+	assert(npp == &np.p.fn);
+	assert((char *)gpp == (char *)&gp + sizeof(int));
+
+	*gpp = add2;
+	assert(gp.fn(1) == 3);
+
+	int	(**lpp)(int) = &sp.fn;
+	*lpp = add1;
+	assert(sp.fn(1) == 2);
+
+	// elements of an array member
+	assert(ap0 == &gp.arr[0]);
+	assert(ap1 == ap0 + 1);
+	assert(ap2 == &sp.arr[1]);
+	assert((char *)ap1 == (char *)&gp + sizeof(int) + 2 * sizeof(gp.fn));
+	*ap0 = add1;
+	*ap1 = add2;
+	assert(gp.arr[0](1) == 2 && gp.arr[1](1) == 3);
+	assert((*app)[1](1) == 3);
+	*ap2 = add2;
+	assert(sp.arr[1](1) == 3);
+
+	// static local
+	static struct procs		ls;
+	static int (**lsp)(int) = &ls.fn;
+	static int (**lsa)(int) = &ls.arr[1];
+	ls.fn = add1;
+	ls.arr[1] = add2;
+	assert((*lsp)(1) == 2);
+	assert((*lsa)(1) == 3);
+	assert(ls.fn(2) == 3 && ls.arr[1](2) == 4);
+
+	// two dimensional arrays
+	w2.fn[0][0] = add1;
+	w2.fn[1][1] = add2;
+	assert(w2.fn[0][0](1) == 2);
+	assert(w2.fn[1][1](1) == 3);
+	*ap10 = add2;
+	assert(w2.fn[1][0](1) == 3 && ap10 == &w2.fn[1][0]);
+	for (int i = 0; i < 2; i++)
+		assert(w2.fn[i][i](1) == 2 + i);
+
+	tab[0][0] = add1;
+	tab[1][1] = add2;
+	assert(tab[0][0](1) == 2);
+	assert(tab[1][1](1) == 3);
+
+	// call edge through a member of an anonymous union and through a variable
+	// index into a two dimensional array member
+	cwu.fn = callee;
+	cw2.fn[0][1] = callee;
+	cw2.fn[1][0] = callee;
+	for (int i = 0; i < 5; i++)
+	{
+		assert(caller_union(i, 2 * i + 1) == ref_caller(i, 2 * i + 1));
+		assert(caller_2d(i & 1, i, 2 * i + 1) == ref_caller(i, 2 * i + 1));
+	}
+	assert(cwu.fn(1, 2) == callee(1, 2));
+
+	return 0;
+}
diff --git a/autotest/funcptrmemberbasetest.cpp b/autotest/funcptrmemberbasetest.cpp
new file mode 100644
index 0000000..62035c0
--- /dev/null
+++ b/autotest/funcptrmemberbasetest.cpp
@@ -0,0 +1,87 @@
+#include <assert.h>
+
+// Function pointer members inherited from a base class, in a global object:
+// assignment, call, and the call being registered (the caller keeps locals
+// live across it, the callee uses a helper with its own locals; the operands
+// stay small so that no intermediate result overflows an int)
+
+__noinline int helper(int a, int b, int c, int d)
+{
+	int t[4];
+	t[0] = a * 3; t[1] = b * 5; t[2] = c * 7; t[3] = d * 11;
+	return t[0] + t[1] + t[2] + t[3];
+}
+
+__noinline int callee(int a, int b)
+{
+	int u = a + 10, v = b + 20, s = u * v;
+	return helper(u, v, s, a ^ b) + s;
+}
+
+__noinline int leaf(int a, int b)
+{
+	return a * 2 + b;
+}
+
+struct Base
+{
+	int		pad;
+	int		(*fn)(int a, int b);
+};
+
+struct Middle : Base
+{
+	char	c;
+};
+
+struct Derived : Middle
+{
+	int		extra;
+	int		(*fn2)(int a, int b);
+};
+
+Derived	gd;
+
+__noinline int caller(int x, int y)
+{
+	int l1 = x * 13, l2 = y * 17, l3 = x * y + 19, l4 = x - y;
+	int r = gd.fn(x, y);
+	return l1 + l2 + l3 + l4 + r;
+}
+
+__noinline int caller2(int x, int y)
+{
+	int l1 = x * 13, l2 = y * 17, l3 = x * y + 19, l4 = x - y;
+	int r = gd.fn2(x, y);
+	return l1 + l2 + l3 + l4 + r;
+}
+
+int ref_caller(int x, int y)
+{
+	int l1 = x * 13, l2 = y * 17, l3 = x * y + 19, l4 = x - y;
+	int u = x + 10, v = y + 20, s = u * v;
+	int r = (u * 3 + v * 5 + s * 7 + (x ^ y) * 11) + s;
+	return l1 + l2 + l3 + l4 + r;
+}
+
+int main(void)
+{
+	gd.fn = leaf;
+	gd.fn2 = leaf;
+	gd.pad = 1; gd.c = 'c'; gd.extra = 2;
+	assert(gd.fn(3, 4) == 10 && (*gd.fn2)(3, 4) == 10);
+	assert(gd.pad == 1 && gd.c == 'c' && gd.extra == 2);
+
+	Base * b = &gd;
+	assert(b->fn(3, 4) == 10);
+	b->fn = callee;
+
+	gd.fn2 = callee;
+	for (int i = 0; i < 5; i++)
+	{
+		assert(caller(i, 2 * i + 1) == ref_caller(i, 2 * i + 1));
+		assert(caller2(i, 2 * i + 1) == ref_caller(i, 2 * i + 1));
+	}
+
+	return 0;
+}
diff --git a/autotest/funcptrmemberconsttest.c b/autotest/funcptrmemberconsttest.c
new file mode 100644
index 0000000..fcd07b4
--- /dev/null
+++ b/autotest/funcptrmemberconsttest.c
@@ -0,0 +1,76 @@
+#include <assert.h>
+
+// Function pointer members of const structs: a call through the member
+// compiles, an assignment to it is rejected with "Cannot assign to const
+// type". Each FUNCPTR_CONST_* selector adds one invalid assignment, for the
+// funcptrmemberconstconstraints rule
+
+int add1(int x)
+{
+	return x + 1;
+}
+
+int add2(int x)
+{
+	return x + 2;
+}
+
+struct procs
+{
+	int		pad;
+	int		(*fn)(int x);
+	int		(*arr[2])(int x);
+};
+
+struct outer
+{
+	char				c;
+	const struct procs	in;
+};
+
+const struct procs	cw = { 0, add1, { add1, add2 } };
+struct procs		w;
+struct outer		ow = { 'o', { 1, add2, { add2, add1 } } };
+const struct procs	tab[2] = { { 0, add1, { add1, add1 } }, { 1, add2, { add2, add2 } } };
+
+__noinline int call_ptr(const struct procs * p, int x)
+{
+	return p->fn(x) + p->arr[1](x);
+}
+
+int main(void)
+{
+	static const struct procs	ls = { 0, add2, { add1, add2 } };
+	const struct procs			lc = { 0, add1, { add2, add1 } };
+
+	assert(cw.fn(1) == 2 && cw.arr[1](1) == 3);
+	assert(ow.in.fn(1) == 3 && ow.in.arr[0](1) == 3);
+	assert(tab[1].fn(1) == 3 && tab[0].arr[1](1) == 2);
+	assert(ls.fn(1) == 3 && lc.fn(1) == 2);
+	assert(call_ptr(&cw, 1) == 2 + 3);
+	assert(call_ptr(&lc, 1) == 2 + 2);
+
+	w.fn = add2;
+	w.arr[0] = add1;
+	w.arr[1] = add1;
+	assert(w.fn(1) == 3 && call_ptr(&w, 1) == 3 + 2);
+
+#if defined(FUNCPTR_CONST_GLOBAL)
+	cw.fn = add2;
+#elif defined(FUNCPTR_CONST_LOCAL)
+	lc.fn = add2;
+#elif defined(FUNCPTR_CONST_STATIC_LOCAL)
+	ls.fn = add2;
+#elif defined(FUNCPTR_CONST_POINTER)
+	const struct procs *	p = &w;
+	p->fn = add2;
+#elif defined(FUNCPTR_CONST_ARRAY)
+	cw.arr[1] = add2;
+#elif defined(FUNCPTR_CONST_NESTED)
+	ow.in.fn = add2;
+#elif defined(FUNCPTR_CONST_ARRAY_OF_STRUCTS)
+	tab[1].fn = add2;
+#endif
+
+	return 0;
+}
diff --git a/autotest/funcptrmembertest.c b/autotest/funcptrmembertest.c
new file mode 100644
index 0000000..5ac9aab
--- /dev/null
+++ b/autotest/funcptrmembertest.c
@@ -0,0 +1,360 @@
+#include <assert.h>
+
+// Function pointer members of global struct variables: assignment, call
+// through s.m(...), (*s.m)(...) and p->m(...), with and without -Ofp
+
+int add1(int x)
+{
+	return x + 1;
+}
+
+int add2(int x)
+{
+	return x + 2;
+}
+
+int add3(int x)
+{
+	return x + 3;
+}
+
+int mul(int x, int y)
+{
+	return x * y;
+}
+
+int sub(int x, int y)
+{
+	return x - y;
+}
+
+static int called;
+
+void setcalled(void)
+{
+	called = 1;
+}
+
+void setcalled_str(const char * s)
+{
+	called = s[0];
+}
+
+struct procs
+{
+	int		(*fn)(int x);
+	int		(*fn2)(int x, int y);
+	void	(*vfn)(void);
+	void	(*sfn)(const char * s);
+};
+
+struct procs		gp;
+static struct procs	sp;
+struct procs		ip = { add1, mul, setcalled, setcalled_str };
+
+// struct declared together with its variable
+struct
+{
+	int		(*fn)(int x);
+}	dp;
+
+// nested struct and array of function pointers
+struct nested
+{
+	char			c;
+	struct procs	p;
+}	np;
+
+struct arrmem
+{
+	int		(*fn[2])(int x);
+}	ap;
+
+// initialized array member at a non zero offset
+struct arrinit
+{
+	int		pad;
+	int		(*fn[2])(int x);
+}	ai = { 123, { add1, add2 } };
+
+// array of structs and struct holding an array of structs, initialized
+struct item
+{
+	char	name;
+	int		(*fn)(int x);
+};
+
+struct item		objects[3] = { { 'a', add1 }, { 'b', add2 }, { 'c', add3 } };
+
+struct table
+{
+	int			pad;
+	struct item	it[2];
+}	tb = { 9, { { 'x', add2 }, { 'y', add3 } } };
+
+// bit fields around the function pointer: fn starts in the second byte of
+// the storage unit of a, so it must be found by the bits used, not by the
+// size of the bit field's type
+struct bits
+{
+	unsigned	a : 3;
+	unsigned	b : 5;
+	int			(*fn)(int x);
+	unsigned	c : 4;
+}	bf;
+
+// initialized, then reassigned in one function and called from another:
+// the write must not be removed as a store to a constant
+struct procs1
+{
+	int		pad;
+	int		(*fn)(int x);
+};
+
+struct procs1			rw = { 0, add1 };
+static struct procs1	rs = { 0, add1 };
+
+struct arrinit			ra = { 0, { add1, add1 } };
+
+struct nested1
+{
+	char			c;
+	struct procs1	p;
+}	rn = { 'n', { 0, add1 } };
+
+__noinline void reassign(void)
+{
+	rw.fn = add2;
+	rs.fn = add2;
+	ra.fn[1] = add2;
+	rn.p.fn = add2;
+}
+
+__noinline int call_reassigned(int x)
+{
+	return rw.fn(x) + rs.fn(x) + ra.fn[1](x) + rn.p.fn(x);
+}
+
+// a call through a member must be registered as a call: the caller keeps
+// locals live across it, and the callee uses a helper with its own locals.
+// The operands stay small so that no intermediate result overflows an int
+struct procs2
+{
+	int		(*fn)(int a, int b);
+}	cw;
+
+struct procsarr
+{
+	int		pad;
+	int		(*fn[2])(int a, int b);
+}	cwa;
+
+int		(*carr[2])(int a, int b);
+
+__noinline int helper(int a, int b, int c, int d)
+{
+	int t[4];
+	t[0] = a * 3; t[1] = b * 5; t[2] = c * 7; t[3] = d * 11;
+	return t[0] + t[1] + t[2] + t[3];
+}
+
+__noinline int callee(int a, int b)
+{
+	int u = a + 10, v = b + 20, s = u * v;
+	return helper(u, v, s, a ^ b) + s;
+}
+
+__noinline int caller(int x, int y)
+{
+	int l1 = x * 13, l2 = y * 17, l3 = x * y + 19, l4 = x - y;
+	int r = cw.fn(x, y);
+	return l1 + l2 + l3 + l4 + r;
+}
+
+__noinline int caller_arr(int x, int y)
+{
+	int l1 = x * 13, l2 = y * 17, l3 = x * y + 19, l4 = x - y;
+	int r = carr[1](x, y);
+	return l1 + l2 + l3 + l4 + r;
+}
+
+__noinline int caller_varidx(int i, int x, int y)
+{
+	int l1 = x * 13, l2 = y * 17, l3 = x * y + 19, l4 = x - y;
+	int r = cwa.fn[i](x, y);
+	return l1 + l2 + l3 + l4 + r;
+}
+
+int ref_caller(int x, int y)
+{
+	int l1 = x * 13, l2 = y * 17, l3 = x * y + 19, l4 = x - y;
+	int u = x + 10, v = y + 20, s = u * v;
+	int r = (u * 3 + v * 5 + s * 7 + (x ^ y) * 11) + s;
+	return l1 + l2 + l3 + l4 + r;
+}
+
+// as used by NetHack's window interface
+#define askname (*ip.vfn)
+
+__noinline void set_procs(struct procs * p, bool c)
+{
+	if (c)
+	{
+		p->fn = add1;
+		p->fn2 = mul;
+	}
+	else
+	{
+		p->fn = add2;
+		p->fn2 = sub;
+	}
+	p->vfn = setcalled;
+	p->sfn = setcalled_str;
+}
+
+__noinline int call_procs(struct procs * p, int x, int y)
+{
+	return p->fn(x) + (*p->fn2)(x, y);
+}
+
+__noinline int call_global(int x, int y)
+{
+	return gp.fn(x) + (*gp.fn2)(x, y);
+}
+
+__noinline int call_static(int x, int y)
+{
+	return sp.fn(x) + (*sp.fn2)(x, y);
+}
+
+__noinline int call_object(int i, int x)
+{
+	return objects[i].fn(x);
+}
+
+__noinline int call_static_local(int x)
+{
+	static struct procs1	ls = { 0, add1 };
+
+	int	r = ls.fn(x);
+	ls.fn = add2;
+	return r;
+}
+
+int main(void)
+{
+	// assign and call, global
+	gp.fn = add1;
+	gp.fn2 = mul;
+	gp.vfn = setcalled;
+	gp.sfn = setcalled_str;
+	assert(gp.fn(1) == 2);
+	assert((*gp.fn)(2) == 3);
+	assert(gp.fn2(3, 4) == 12);
+	assert((*gp.fn2)(5, 6) == 30);
+	called = 0; gp.vfn(); assert(called == 1);
+	called = 0; gp.sfn("x"); assert(called == 'x');
+	assert(call_global(2, 3) == 3 + 6);
+
+	// static global
+	sp.fn = add2;
+	sp.fn2 = sub;
+	assert(sp.fn(1) == 3);
+	assert((*sp.fn2)(5, 2) == 3);
+	assert(call_static(2, 3) == 4 - 1);
+
+	// global with initializer
+	assert(ip.fn(1) == 2);
+	assert(ip.fn2(3, 4) == 12);
+	called = 0; askname(); assert(called == 1);
+	called = 0; ip.sfn("y"); assert(called == 'y');
+
+	// struct declared together with its variable
+	dp.fn = add2;
+	assert(dp.fn(1) == 3);
+
+	// through a pointer to the global, functions chosen at runtime
+	for (int i = 0; i < 2; i++)
+	{
+		bool	c = i == 0;
+
+		set_procs(&gp, c);
+		assert(gp.fn(10) == (c ? 11 : 12));
+		assert(gp.fn2(10, 2) == (c ? 20 : 8));
+		assert(call_procs(&gp, 10, 2) == (c ? 11 + 20 : 12 + 8));
+		assert(call_global(10, 2) == (c ? 11 + 20 : 12 + 8));
+
+		set_procs(&sp, !c);
+		assert(call_static(10, 2) == (c ? 12 + 8 : 11 + 20));
+
+		called = 0; gp.vfn(); assert(called == 1);
+		called = 0; sp.sfn("z"); assert(called == 'z');
+	}
+
+	// nested struct
+	np.p.fn = add1;
+	np.p.fn2 = sub;
+	assert(np.p.fn(1) == 2);
+	assert((*np.p.fn2)(4, 1) == 3);
+
+	// array of function pointers
+	ap.fn[0] = add1;
+	ap.fn[1] = add2;
+	assert(ap.fn[0](1) == 2);
+	assert(ap.fn[1](1) == 3);
+	for (int i = 0; i < 2; i++)
+		assert(ap.fn[i](5) == 6 + i);
+
+	// initialized array member
+	assert(ai.pad == 123);
+	assert(ai.fn[0](1) == 2);
+	assert(ai.fn[1](1) == 3);
+	for (int i = 0; i < 2; i++)
+		assert(ai.fn[i](5) == 6 + i);
+
+	// array of structs
+	assert(objects[0].fn(1) == 2 && objects[1].fn(1) == 3 && objects[2].fn(1) == 4);
+	assert(call_object(1, 10) == 12);
+	objects[1].fn = add3;
+	assert(objects[1].fn(1) == 4 && call_object(1, 1) == 4);
+	assert(tb.it[0].fn(1) == 3 && tb.it[1].fn(1) == 4);
+	assert(tb.pad == 9 && tb.it[1].name == 'y');
+	tb.it[0].fn = add1;
+	assert(tb.it[0].fn(1) == 2);
+
+	// bit fields around the member
+	bf.a = 5; bf.b = 21; bf.c = 9;
+	bf.fn = add1;
+	assert(bf.fn(1) == 2);
+	assert(bf.a == 5 && bf.b == 21 && bf.c == 9);
+
+	// initialized, then reassigned
+	assert(call_reassigned(1) == 4 * 2);
+	reassign();
+	assert(call_reassigned(1) == 4 * 3);
+	assert(rw.fn(1) == 3 && rs.fn(1) == 3 && ra.fn[1](1) == 3 && rn.p.fn(1) == 3);
+	assert(ra.fn[0](1) == 2 && rn.c == 'n');
+
+	// static local
+	assert(call_static_local(1) == 2);
+	assert(call_static_local(1) == 3);
+
+	// call edge through a member, through a constant array index and through
+	// a variable index into an array member
+	cw.fn = callee;
+	carr[1] = callee;
+	cwa.fn[0] = callee;
+	cwa.fn[1] = callee;
+	for (int i = 0; i < 5; i++)
+	{
+		assert(caller(i, 2 * i + 1) == ref_caller(i, 2 * i + 1));
+		assert(caller_arr(i, 2 * i + 1) == ref_caller(i, 2 * i + 1));
+		assert(caller_varidx(i & 1, i, 2 * i + 1) == ref_caller(i, 2 * i + 1));
+	}
+
+	// member read as a value
+	int	(*f)(int) = gp.fn;
+	assert(f(7) == gp.fn(7));
+
+	return 0;
+}
