+// The save (restore false) or the restore of the callee-saved temporaries lo to hi
+// (offsets from BC_REG_TMP_SAVED), into the same save area slots as Compile's full
+// sequence: in the save object, or at stack slot mTempSaveSlot + k for byte k.  X is only
+// used where Compile's sequence used it: a procedure that does not touch X tells its
+// callers so (LOBJF_PRESERVE_REG_X).
+void NativeCodeProcedure::BuildTempSaves(ExpandingArray<NativeCodeInstruction>& ins, const InterInstruction* iins, bool restore, int lo, int hi)
+{
+	int	n = hi - lo + 1;
+	if (n <= 0)
+		return;
+
+	if (mTempSaveKind == NTS_STATIC)
+	{
+		LinkerObject* sobj = mInterProc->mSaveTempsLinkerObject;
+		if (mTempSaveUsesX && n > 3)
+		{
+			ins.Push(NativeCodeInstruction(iins, ASMIT_LDX, ASMIM_IMMEDIATE, n - 1));
+			if (restore)
+			{
+				ins.Push(NativeCodeInstruction(iins, ASMIT_LDA, ASMIM_ABSOLUTE_X, lo, sobj));
+				ins.Push(NativeCodeInstruction(iins, ASMIT_STA, ASMIM_ZERO_PAGE_X, BC_REG_TMP_SAVED + lo));
+			}
+			else
+			{
+				ins.Push(NativeCodeInstruction(iins, ASMIT_LDA, ASMIM_ZERO_PAGE_X, BC_REG_TMP_SAVED + lo));
+				ins.Push(NativeCodeInstruction(iins, ASMIT_STA, ASMIM_ABSOLUTE_X, lo, sobj));
+			}
+			ins.Push(NativeCodeInstruction(iins, ASMIT_DEX, ASMIM_IMPLIED));
+			ins.Push(NativeCodeInstruction(iins, ASMIT_BPL, ASMIM_RELATIVE, -8));
+		}
+		else
+		{
+			for (int k = lo; k <= hi; k++)
+			{
+				if (restore)
+				{
+					ins.Push(NativeCodeInstruction(iins, ASMIT_LDA, ASMIM_ABSOLUTE, k, sobj));
+					ins.Push(NativeCodeInstruction(iins, ASMIT_STA, ASMIM_ZERO_PAGE, BC_REG_TMP_SAVED + k));
+				}
+				else
+				{
+					ins.Push(NativeCodeInstruction(iins, ASMIT_LDA, ASMIM_ZERO_PAGE, BC_REG_TMP_SAVED + k));
+					ins.Push(NativeCodeInstruction(iins, ASMIT_STA, ASMIM_ABSOLUTE, k, sobj));
+				}
+			}
+		}
+		return;
+	}
+
+	int	slot = mTempSaveSlot;
+	if (n <= 2)
+	{
+		ins.Push(NativeCodeInstruction(iins, ASMIT_LDY, ASMIM_IMMEDIATE, slot + hi));
+		for (int k = hi; k >= lo; k--)
+		{
+			if (k < hi)
+				ins.Push(NativeCodeInstruction(iins, ASMIT_DEY, ASMIM_IMPLIED));
+			if (restore)
+			{
+				ins.Push(NativeCodeInstruction(iins, ASMIT_LDA, ASMIM_INDIRECT_Y, BC_REG_STACK));
+				ins.Push(NativeCodeInstruction(iins, ASMIT_STA, ASMIM_ZERO_PAGE, BC_REG_TMP_SAVED + k));
+			}
+			else
+			{
+				ins.Push(NativeCodeInstruction(iins, ASMIT_LDA, ASMIM_ZERO_PAGE, BC_REG_TMP_SAVED + k));
+				ins.Push(NativeCodeInstruction(iins, ASMIT_STA, ASMIM_INDIRECT_Y, BC_REG_STACK));
+			}
+		}
+	}
+	else if (mTempSaveUsesX)
+	{
+		ins.Push(NativeCodeInstruction(iins, ASMIT_LDY, ASMIM_IMMEDIATE, slot + hi));
+		ins.Push(NativeCodeInstruction(iins, ASMIT_LDX, ASMIM_IMMEDIATE, n - 1));
+		if (restore)
+		{
+			ins.Push(NativeCodeInstruction(iins, ASMIT_LDA, ASMIM_INDIRECT_Y, BC_REG_STACK));
+			ins.Push(NativeCodeInstruction(iins, ASMIT_STA, ASMIM_ZERO_PAGE_X, BC_REG_TMP_SAVED + lo));
+		}
+		else
+		{
+			ins.Push(NativeCodeInstruction(iins, ASMIT_LDA, ASMIM_ZERO_PAGE_X, BC_REG_TMP_SAVED + lo));
+			ins.Push(NativeCodeInstruction(iins, ASMIT_STA, ASMIM_INDIRECT_Y, BC_REG_STACK));
+		}
+		ins.Push(NativeCodeInstruction(iins, ASMIT_DEY, ASMIM_IMPLIED));
+		ins.Push(NativeCodeInstruction(iins, ASMIT_DEX, ASMIM_IMPLIED));
+		ins.Push(NativeCodeInstruction(iins, ASMIT_BPL, ASMIM_RELATIVE, -8));
+	}
+	else
+	{
+		// Y alone indexes both the slot and the byte (an absolute address below 256 with ,y
+		// is assembled in three bytes: LDA and STA have no zero page,y form)
+		assert(slot <= BC_REG_TMP_SAVED);
+		ins.Push(NativeCodeInstruction(iins, ASMIT_LDY, ASMIM_IMMEDIATE, slot + hi));
+		if (restore)
+		{
+			ins.Push(NativeCodeInstruction(iins, ASMIT_LDA, ASMIM_INDIRECT_Y, BC_REG_STACK));
+			ins.Push(NativeCodeInstruction(iins, ASMIT_STA, ASMIM_ABSOLUTE_Y, BC_REG_TMP_SAVED - slot));
+		}
+		else
+		{
+			ins.Push(NativeCodeInstruction(iins, ASMIT_LDA, ASMIM_ABSOLUTE_Y, BC_REG_TMP_SAVED - slot));
+			ins.Push(NativeCodeInstruction(iins, ASMIT_STA, ASMIM_INDIRECT_Y, BC_REG_STACK));
+		}
+		ins.Push(NativeCodeInstruction(iins, ASMIT_DEY, ASMIM_IMPLIED));
+		if (slot + lo == 0)
+			ins.Push(NativeCodeInstruction(iins, ASMIT_BPL, ASMIM_RELATIVE, -8));
+		else
+		{
+			ins.Push(NativeCodeInstruction(iins, ASMIT_CPY, ASMIM_IMMEDIATE, slot + lo));
+			ins.Push(NativeCodeInstruction(iins, ASMIT_BCS, ASMIM_RELATIVE, -10));
+		}
+	}
+}
+
+// Save and restore only the callee-saved temporaries in runs (pairs of offsets lo, hi; none
+// if empty), in place of Compile's sequences, which nothing has changed since (the entry
+// and exit blocks hold only the prologue and the epilogue).
+void NativeCodeProcedure::NarrowTempSaves(const ExpandingArray<int>& runs)
+{
+	ExpandingArray<NativeCodeInstruction>	save, restore;
+	for (int r = 0; r + 1 < runs.Size(); r += 2)
+	{
+		BuildTempSaves(save, nullptr, false, runs[r], runs[r + 1]);
+		BuildTempSaves(restore, mExitBlock->mBranchIns, true, runs[r], runs[r + 1]);
+	}
+
+	mEntryBlock->mIns.Remove(mTempSaveBegin, mTempSaveEnd - mTempSaveBegin);
+	for (int i = 0; i < save.Size(); i++)
+		mEntryBlock->mIns.Insert(mTempSaveBegin + i, save[i]);
+	mTempSaveEnd = mTempSaveBegin + save.Size();
+
+	mExitBlock->mIns.Remove(mTempRestoreBegin, mTempRestoreEnd - mTempRestoreBegin);
+	for (int i = 0; i < restore.Size(); i++)
+		mExitBlock->mIns.Insert(mTempRestoreBegin + i, restore[i]);
+	mTempRestoreEnd = mTempRestoreBegin + restore.Size();
+
+	// The bytes left out are now changed by this procedure, which its zero page set (made
+	// when the full save was assumed) did not say
+	if (mLinkerObject->mFlags & LOBJF_ZEROPAGESET)
+	{
+		for (int k = 0; k < mTempSave; k++)
+		{
+			bool	kept = false;
+			for (int r = 0; r + 1 < runs.Size(); r += 2)
+				if (k >= runs[r] && k <= runs[r + 1])
+					kept = true;
+			if (!kept)
+				mLinkerObject->mZeroPageSet += BC_REG_TMP_SAVED + k;
+		}
+	}
+}
