+// A procedure saves the callee-saved temporaries it uses (BC_REG_TMP_SAVED on) when it is
+// entered and restores them when it returns, for whoever called it.  It only has to keep
+// the bytes a caller needs: those the caller reads after the call before it writes them,
+// and those the caller's own callers need and the caller does not restore itself.  When
+// this runs every procedure is compiled and no call has been changed into a stub, a proxy
+// or an outlined sequence yet, so every direct call is a JSR or JMP to its procedure.  A
+// procedure whose address is taken, that an interrupt can reach, or that something other
+// than a native procedure refers to keeps its full save, and so does what its callees owe
+// to it.  Saving fewer bytes changes nothing else: the frame keeps its size and its slots.
+void NativeCodeGenerator::ReduceTempSaves(void)
+{
+	int	np = mProcedures.Size();
+	if (np == 0)
+		return;
+
+	for (int i = 0; i < np; i++)
+		mProcedures[i]->mTempSaveIndex = i;
+
+	ZeroPageSet	all;
+	for (int k = BC_REG_TMP_SAVED; k < 256; k++)
+		all += k;
+
+	ZeroPageSet	*	need = new ZeroPageSet[np];
+	ZeroPageSet	*	used = new ZeroPageSet[np];
+	bool		*	escaped = new bool[np];
+
+	for (int i = 0; i < np; i++)
+	{
+		NativeCodeProcedure* p = mProcedures[i];
+		InterCodeProcedure* ip = p->mInterProc;
+		escaped[i] = !ip || !p->mEntryBlock || ip->mInterrupt || ip->mHardwareInterrupt || ip->mInterruptCalled || ip->mFuncVariable || ip->mDispatchedCall;
+		for (int k = 0; k < p->mTempSave; k++)
+			used[i] += BC_REG_TMP_SAVED + k;
+	}
+
+	// Referred to from data (a function pointer), assembler or the runtime: native
+	// procedures have no references of their own before they are assembled.  The startup
+	// code calls main, and returns to basic after it, which needs basic's zero page as
+	// it was, so main keeps it all, unless the program does not return to basic (-xz,
+	// -xb): then the startup is main's only caller and needs nothing.
+	bool	basicReturn = !(mCompilerOptions & (COPT_EXTENDED_ZERO_PAGE | COPT_NO_BASIC_RETURN));
+	for (int i = 0; i < mLinker->mObjects.Size(); i++)
+	{
+		LinkerObject* lo = mLinker->mObjects[i];
+		for (int j = 0; j < lo->mReferences.Size(); j++)
+		{
+			LinkerObject* ro = lo->mReferences[j]->mRefObject;
+			if (ro && ro->mNativeProc && ro->mNativeProc->mTempSaveIndex >= 0)
+			{
+				NativeCodeProcedure* rp = ro->mNativeProc;
+				if (basicReturn || !rp->mIdent || strcmp(rp->mIdent->mString, "main") || !lo->mIdent || strcmp(lo->mIdent->mString, "startup"))
+					escaped[rp->mTempSaveIndex] = true;
+			}
+		}
+	}
+
+	struct TempSaveCall
+	{
+		int			mCaller, mCallee;
+		bool		mTail;
+		ZeroPageSet	mLive;
+	};
+	ExpandingArray<TempSaveCall>	calls;
+
+	for (int i = 0; i < np; i++)
+	{
+		NativeCodeProcedure* p = mProcedures[i];
+		if (!p->mEntryBlock)
+			continue;
+
+		p->ResetVisited();
+		p->mEntryBlock->BuildLocalRegSets();
+		p->ResetVisited();
+		p->mEntryBlock->BuildGlobalProvidedRegSet(NumberSet(NUM_REGS));
+		NumberSet	total(NUM_REGS);
+		do {
+			p->ResetVisited();
+		} while (p->mEntryBlock->BuildGlobalRequiredRegSet(total));
+
+		ExpandingArray<NativeCodeBasicBlock*>	blocks;
+		p->ResetVisited();
+		p->mEntryBlock->mVisited = true;
+		blocks.Push(p->mEntryBlock);
+		for (int bi = 0; bi < blocks.Size(); bi++)
+		{
+			NativeCodeBasicBlock* b = blocks[bi];
+			if (b->mTrueJump && !b->mTrueJump->mVisited)
+			{
+				b->mTrueJump->mVisited = true;
+				blocks.Push(b->mTrueJump);
+			}
+			if (b->mFalseJump && !b->mFalseJump->mVisited)
+			{
+				b->mFalseJump->mVisited = true;
+				blocks.Push(b->mFalseJump);
+			}
+		}
+
+		// Indexed or absolute accesses to the zero page from the temporaries up, which
+		// the data flow sets do not follow, are taken as live after every call: a copy
+		// loop (LDX #n / LDA zp,x ... / DEX / BPL) reaches zp to zp + n; anything else
+		// makes the procedure opaque, all of the area live (the entry and the exit block
+		// hold this procedure's own save and restore)
+		bool		opaque = false;
+		ZeroPageSet	indexed;
+		int			first = calls.Size();
+		for (int bi = 0; bi < blocks.Size(); bi++)
+		{
+			NativeCodeBasicBlock* b = blocks[bi];
+			for (int j = 0; j < b->mIns.Size(); j++)
+			{
+				const NativeCodeInstruction& ins(b->mIns[j]);
+
+				if (b != p->mEntryBlock && b != p->mExitBlock)
+				{
+					bool	ix = (ins.mMode == ASMIM_ZERO_PAGE_X || ins.mMode == ASMIM_ABSOLUTE_X && !ins.mLinkerObject) && ins.mAddress < 256;
+					bool	iy = (ins.mMode == ASMIM_ZERO_PAGE_Y || ins.mMode == ASMIM_ABSOLUTE_Y && !ins.mLinkerObject) && ins.mAddress < 256;
+
+					if (ins.mMode == ASMIM_INDIRECT_X && ins.mAddress >= BC_REG_TMP)
+						opaque = true;
+					else if (ins.mMode == ASMIM_ABSOLUTE && !ins.mLinkerObject && ins.mAddress < 256)
+						indexed += int(ins.mAddress);
+					else if ((ix || iy) && ins.mAddress + 255 >= BC_REG_TMP_SAVED && ins.mAddress >= BC_REG_TMP)
+					{
+						AsmInsType	ld = ix ? ASMIT_LDX : ASMIT_LDY, de = ix ? ASMIT_DEX : ASMIT_DEY;
+
+						int	n = -1;
+						for (int k = j - 1; k >= 0; k--)
+						{
+							const NativeCodeInstruction& pins(b->mIns[k]);
+							if (ix ? pins.ChangesXReg() : pins.ChangesYReg())
+							{
+								if (pins.mType == ld && pins.mMode == ASMIM_IMMEDIATE)
+									n = int(pins.mAddress);
+								break;
+							}
+						}
+						int k = j + 1;
+						while (k < b->mIns.Size() && !(ix ? b->mIns[k].ChangesXReg() : b->mIns[k].ChangesYReg()))
+							k++;
+						if (n < 0 || k < b->mIns.Size() && b->mIns[k].mType != de)
+							opaque = true;
+						else
+						{
+							for (int a = int(ins.mAddress); a <= int(ins.mAddress) + n && a < 256; a++)
+								indexed += a;
+						}
+					}
+				}
+
+				if (ins.mLinkerObject && ins.mLinkerObject->mNativeProc && ins.mLinkerObject->mNativeProc->mTempSaveIndex >= 0)
+				{
+					int	ci = ins.mLinkerObject->mNativeProc->mTempSaveIndex;
+					if ((ins.mType == ASMIT_JSR || ins.mType == ASMIT_JMP) && ins.mMode == ASMIM_ABSOLUTE && ins.mAddress == 0)
+					{
+						TempSaveCall	c;
+						c.mCaller = i;
+						c.mCallee = ci;
+						c.mTail = ins.mType == ASMIT_JMP;
+						if (!c.mTail)
+						{
+							NumberSet	req(NUM_REGS), prov(NUM_REGS);
+							for (int k = j + 1; k < b->mIns.Size(); k++)
+								b->mIns[k].FilterRegUsage(req, prov);
+							NumberSet	live(b->mExitRequiredRegs);
+							live -= prov;
+							live |= req;
+							for (int k = BC_REG_TMP_SAVED; k < 256; k++)
+								if (live[k])
+									c.mLive += k;
+						}
+						calls.Push(c);
+					}
+					else
+						escaped[ci] = true;
+				}
+			}
+		}
+
+		for (int k = first; k < calls.Size(); k++)
+		{
+			if (opaque)
+				calls[k].mLive = all;
+			else
+				calls[k].mLive |= indexed;
+		}
+	}
+
+	for (int i = 0; i < np; i++)
+		if (escaped[i])
+			need[i] = all;
+
+	// What a callee must keep: what the caller needs after the call, and what the caller's
+	// callers need from bytes the caller does not save (all of it, for a tail call)
+	bool	changed;
+	do {
+		changed = false;
+		for (int e = 0; e < calls.Size(); e++)
+		{
+			const TempSaveCall& c(calls[e]);
+			for (int w = 0; w < 8; w++)
+			{
+				uint32	add = c.mLive.mBits[w] | (c.mTail ? need[c.mCaller].mBits[w] : need[c.mCaller].mBits[w] & ~used[c.mCaller].mBits[w]);
+				if (add & ~need[c.mCallee].mBits[w])
+				{
+					need[c.mCallee].mBits[w] |= add;
+					changed = true;
+				}
+			}
+		}
+	} while (changed);
+
+	int	nsave = 0, nnarrow = 0, before = 0, after = 0;
+	for (int i = 0; i < np; i++)
+	{
+		NativeCodeProcedure* p = mProcedures[i];
+		if (p->mTempSaveKind == NativeCodeProcedure::NTS_NONE)
+			continue;
+		nsave++;
+		before += p->mTempSave;
+
+		// The bytes to keep, in runs.  A run costs about twelve bytes of code each way and a
+		// few cycles, a byte saved for nothing about 33 cycles a call: runs closer than four
+		// bytes are one, and there are three at most (the closest are merged).
+		ExpandingArray<int>	runs;
+		int	exact = 0;
+		for (int k = 0; k < p->mTempSave; k++)
+		{
+			if (need[i][BC_REG_TMP_SAVED + k])
+			{
+				exact++;
+				if (runs.Size() && k - runs[runs.Size() - 1] <= 4)
+					runs[runs.Size() - 1] = k;
+				else
+				{
+					runs.Push(k);
+					runs.Push(k);
+				}
+			}
+		}
+		while (runs.Size() > 6)
+		{
+			int	best = 2;
+			for (int r = 4; r < runs.Size(); r += 2)
+				if (runs[r] - runs[r - 1] < runs[best] - runs[best - 1])
+					best = r;
+			runs[best - 1] = runs[best + 1];
+			runs.Remove(best, 2);
+		}
+		int	kept = 0;
+		for (int r = 0; r + 1 < runs.Size(); r += 2)
+			kept += runs[r + 1] - runs[r] + 1;
+		int	lo = runs.Size() ? runs[0] : p->mTempSave, hi = runs.Size() ? runs[runs.Size() - 1] : -1;
+
+		if (escaped[i] || kept == p->mTempSave)
+		{
+			after += p->mTempSave;
+			if (mCompilerOptions & COPT_VERBOSE2)
+				printf("Temp saves <%s> %d -> %d%s\n", p->mIdent->mString, p->mTempSave, p->mTempSave, escaped[i] ? " (escapes)" : "");
+			continue;
+		}
+
+		after += kept;
+		if (mCompilerOptions & COPT_VERBOSE2)
+			printf("Temp saves <%s> %d -> %d in %d runs [%d..%d], %d needed\n", p->mIdent->mString, p->mTempSave, kept, runs.Size() / 2, lo, hi, exact);
+		p->NarrowTempSaves(runs);
+		nnarrow++;
+	}
+
+	if (mCompilerOptions & COPT_VERBOSE)
+		printf("Temp saves: %d of %d procedures that save narrowed, %d of %d bytes kept\n", nnarrow, nsave, after, before);
+
+	delete[] need;
+	delete[] used;
+	delete[] escaped;
+}
