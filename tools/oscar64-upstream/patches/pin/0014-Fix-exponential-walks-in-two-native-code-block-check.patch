 autotest/conditionchainwalktest.c | 91 +++++++++++++++++++++++++++++++
 oscar64/NativeCodeGenerator.cpp   | 37 ++++++++++++-
 oscar64/NativeCodeGenerator.h     |  2 +
 4 files changed, 131 insertions(+), 2 deletions(-)
