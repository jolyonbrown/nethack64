diff --git a/autotest/funcptrmembercalltest.c b/autotest/funcptrmembercalltest.c
new file mode 100644
index 0000000..9d095c9
--- /dev/null
+++ b/autotest/funcptrmembercalltest.c
@@ -0,0 +1,128 @@
+#include <assert.h>
+
+// A call through a function pointer member of a global struct (w.fn(...)),
+// an element of a global array of structs (s[1].fn(...)), a nested member
+// (o.in.fn(...)), an array member with a constant index (w.arr[1](...)) or
+// a constant index into a global array of function pointers (tab[1](...))
+// must be registered as a call: the caller keeps locals live across it,
+// and the callee uses a helper with its own locals, so a missing call
+// edge lets the helper's frame overlap the caller's live locals.
+// A plain global function pointer and p->fn are the controls.
+
+struct procs { int (*fn)(int a, int b); } w;
+
+struct procs s[3];
+
+struct in { int pad; int (*fn)(int a, int b); };
+struct outer { char c; struct in in; } o;
+
+struct procs_arr { int (*arr[2])(int a, int b); } wa;
+
+int (*tab[2])(int a, int b);
+
+int (*g)(int a, int b);
+
+struct procs * volatile pw = &w;
+
+__noinline int helper(int a, int b, int c, int d)
+{
+	int t[4];
+	t[0] = a * 3; t[1] = b * 5; t[2] = c * 7; t[3] = d * 11;
+	return t[0] + t[1] + t[2] + t[3];
+}
+
+__noinline int callee(int a, int b)
+{
+	int u = a + 100, v = b + 200, s = u * v;
+	return helper(u, v, s, a ^ b) + s;
+}
+
+__noinline int call_member(int x, int y)
+{
+	int l1 = x * 13, l2 = y * 17, l3 = x * y + 19, l4 = x - y;
+	int r = w.fn(x, y);
+	return l1 + l2 + l3 + l4 + r;
+}
+
+__noinline int call_member_deref(int x, int y)
+{
+	int l1 = x * 13, l2 = y * 17, l3 = x * y + 19, l4 = x - y;
+	int r = (*w.fn)(x, y);
+	return l1 + l2 + l3 + l4 + r;
+}
+
+__noinline int call_array_of_structs(int x, int y)
+{
+	int l1 = x * 13, l2 = y * 17, l3 = x * y + 19, l4 = x - y;
+	int r = s[1].fn(x, y);
+	return l1 + l2 + l3 + l4 + r;
+}
+
+__noinline int call_nested(int x, int y)
+{
+	int l1 = x * 13, l2 = y * 17, l3 = x * y + 19, l4 = x - y;
+	int r = o.in.fn(x, y);
+	return l1 + l2 + l3 + l4 + r;
+}
+
+__noinline int call_array_member(int x, int y)
+{
+	int l1 = x * 13, l2 = y * 17, l3 = x * y + 19, l4 = x - y;
+	int r = wa.arr[1](x, y);
+	return l1 + l2 + l3 + l4 + r;
+}
+
+__noinline int call_table(int x, int y)
+{
+	int l1 = x * 13, l2 = y * 17, l3 = x * y + 19, l4 = x - y;
+	int r = tab[1](x, y);
+	return l1 + l2 + l3 + l4 + r;
+}
+
+__noinline int call_plain(int x, int y)
+{
+	int l1 = x * 13, l2 = y * 17, l3 = x * y + 19, l4 = x - y;
+	int r = g(x, y);
+	return l1 + l2 + l3 + l4 + r;
+}
+
+__noinline int call_through_pointer(int x, int y)
+{
+	int l1 = x * 13, l2 = y * 17, l3 = x * y + 19, l4 = x - y;
+	int r = pw->fn(x, y);
+	return l1 + l2 + l3 + l4 + r;
+}
+
+int ref_caller(int x, int y)
+{
+	int l1 = x * 13, l2 = y * 17, l3 = x * y + 19, l4 = x - y;
+	int u = x + 100, v = y + 200, s = u * v;
+	int r = (u * 3 + v * 5 + s * 7 + (x ^ y) * 11) + s;
+	return l1 + l2 + l3 + l4 + r;
+}
+
+int main(void)
+{
+	w.fn = callee;
+	s[1].fn = callee;
+	o.in.fn = callee;
+	wa.arr[1] = callee;
+	tab[1] = callee;
+	g = callee;
+
+	for (int i = 0; i < 5; i++)
+	{
+		int x = i, y = 2 * i + 1, r = ref_caller(x, y);
+
+		assert(call_member(x, y) == r);
+		assert(call_member_deref(x, y) == r);
+		assert(call_array_of_structs(x, y) == r);
+		assert(call_nested(x, y) == r);
+		assert(call_array_member(x, y) == r);
+		assert(call_table(x, y) == r);
+		assert(call_plain(x, y) == r);
+		assert(call_through_pointer(x, y) == r);
+	}
+
+	return 0;
+}
diff --git a/oscar64/GlobalAnalyzer.cpp b/oscar64/GlobalAnalyzer.cpp
index 260b184..e01976c 100644
--- a/oscar64/GlobalAnalyzer.cpp
+++ b/oscar64/GlobalAnalyzer.cpp
@@ -955,6 +955,15 @@ Declaration * GlobalAnalyzer::Analyze(Expression* exp, Declaration* procDec, uin
 				vdec->mFlags |= DTF_ANALYZED;
 			}
 		}
+
+		if (exp->mDecValue->mType == DT_VARIABLE_REF)
+		{
+			// function pointer in a global aggregate, so a call through it registers
+			Declaration* ftype = exp->mDecType;
+			if (ftype->mType == DT_TYPE_FUNCTION || ftype->mType == DT_TYPE_POINTER && ftype->mBase->mType == DT_TYPE_FUNCTION)
+				return ftype;
+		}
+
 		return vdec;
 	}
 	case EX_INITIALIZATION:
