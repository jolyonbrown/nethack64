-Expression* Expression::ConstantFold(Errors * errors, LinkerSection * dataSection, Linker* linker)
+bool Expression::IsIntegerConstantExpression(void) const
+{
+	if (mNonConstExpression || !mDecType || !mDecType->IsIntegerType())
+		return false;
+
+	switch (mType)
+	{
+	case EX_CONSTANT:
+		return mDecValue->mType == DT_CONST_INTEGER;
+	case EX_PREFIX:
+		if (mToken == TK_SIZEOF)
+			return true;
+		return (mToken == TK_ADD || mToken == TK_SUB || mToken == TK_BINARY_NOT) &&
+			mLeft->IsIntegerConstantExpression();
+	case EX_LOGICAL_NOT:
+		return mLeft->IsIntegerConstantExpression();
+	case EX_TYPECAST:
+		// A floating constant is allowed only as the immediate operand of a cast.
+		return mLeft->IsIntegerConstantExpression() ||
+			(mLeft->mType == EX_CONSTANT && !mLeft->mNonConstExpression &&
+			 mLeft->mDecValue->mType == DT_CONST_FLOAT);
+	case EX_BINARY:
+	case EX_RELATIONAL:
+	case EX_LOGICAL_AND:
+	case EX_LOGICAL_OR:
+		return mLeft->IsIntegerConstantExpression() && mRight->IsIntegerConstantExpression();
+	case EX_CONDITIONAL:
+		return mLeft->IsIntegerConstantExpression() &&
+			mRight->mLeft->IsIntegerConstantExpression() && mRight->mRight->IsIntegerConstantExpression();
+	default:
+		return false;
+	}
+}
+
+Expression* Expression::ConstantFold(Errors* errors, LinkerSection* dataSection, Linker* linker)
+{
+	Expression* exp = ConstantFoldValue(errors, dataSection, linker);
+	// Optimisation can fold variables and floating arithmetic too. Preserve that
+	// distinction when checking for an integer null pointer constant in the parser.
+	if (exp != this && exp->mType == EX_CONSTANT &&
+		(exp->mDecValue->mType == DT_CONST_INTEGER || exp->mDecValue->mType == DT_CONST_FLOAT) &&
+		!IsIntegerConstantExpression())
+	{
+		exp = exp->Clone();
+		exp->mNonConstExpression = true;
+	}
+	return exp;
+}
+
