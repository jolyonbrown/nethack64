+// The general folder leaves logical negation for code generation. A null
+// pointer constant needs its integer value now, including inside arithmetic.
+static Expression* FoldIntegerConstantExpression(Expression* exp, Errors* errors, LinkerSection* section)
+{
+	if (exp->mType == EX_CONSTANT)
+		return exp;
+
+	exp = exp->Clone();
+	if (exp->mLeft)
+		exp->mLeft = FoldIntegerConstantExpression(exp->mLeft, errors, section);
+	if (exp->mRight)
+		exp->mRight = FoldIntegerConstantExpression(exp->mRight, errors, section);
+	if (exp->mType == EX_LOGICAL_NOT)
+	{
+		exp->mType = EX_RELATIONAL;
+		exp->mToken = TK_EQUAL;
+		exp->mRight = new Expression(exp->mLocation, EX_CONSTANT);
+		exp->mRight->mDecType = TheSignedIntTypeDeclaration;
+		exp->mRight->mDecValue = TheZeroIntegerConstDeclaration;
+	}
+	return exp->ConstantFold(errors, section);
+}
+
 Expression* Parser::ParseConditionalExpression(bool lhs)
 {
 	Expression* exp = ParseLogicOrExpression(lhs);
@@ -10569,6 +10595,40 @@ Expression* Parser::ParseConditionalExpression(bool lhs)
 		texp->mLeft = ParseLogicOrExpression(false);
 		ConsumeToken(TK_COLON);
 		texp->mRight = ParseConditionalExpression(false);
+
+		// Resolve pointer/null conditionals before assigning the expression type.
+		// Use the same typed address constant as an explicit pointer cast, so both
+		// conditional code generation paths (select and branches) see pointers.
+		for (int i = 0; i < 2; i++)
+		{
+			Expression*& zexp = i ? texp->mLeft : texp->mRight;
+			Expression*& pexp = i ? texp->mRight : texp->mLeft;
+			Declaration* ptype = pexp->mDecType;
+			if (zexp->mDecType->IsNumericType() &&
+				(ptype->mType == DT_TYPE_ARRAY || ptype->mType == DT_TYPE_FUNCTION))
+			{
+				ptype = (ptype->mType == DT_TYPE_ARRAY ? ptype->mBase : ptype)->BuildPointer(pexp->mLocation);
+				Expression* cexp = new Expression(pexp->mLocation, EX_TYPECAST);
+				cexp->mLeft = pexp;
+				cexp->mDecType = ptype;
+				// Keep decay explicit: a function constant still carries its
+				// function declaration's type when translated to intermediate code.
+				pexp = cexp;
+			}
+			if (ptype->mType == DT_TYPE_POINTER && zexp->IsIntegerConstantExpression())
+				zexp = FoldIntegerConstantExpression(zexp, mErrors, mDataSection);
+			if (zexp->mType == EX_CONSTANT && zexp->IsIntegerConstantExpression() &&
+				zexp->mDecValue->mType == DT_CONST_INTEGER && zexp->mDecValue->mInteger == 0 &&
+				ptype->mType == DT_TYPE_POINTER)
+			{
+				Expression* cexp = new Expression(zexp->mLocation, EX_TYPECAST);
+				cexp->mLeft = zexp;
+				cexp->mDecType = ptype;
+				zexp = cexp->ConstantFold(mErrors, mDataSection);
+			}
+			else if (ptype->mType == DT_TYPE_POINTER && zexp->mDecType->IsNumericType())
+				mErrors->Error(zexp->mLocation, EERR_INCOMPATIBLE_OPERATOR, "Incompatible conditional types");
+		}
 		
 		texp->mDecType = texp->mLeft->mDecType;
 		nexp->mDecType = texp->mLeft->mDecType;
