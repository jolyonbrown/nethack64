From 05b403aa98344cafc1e3dc919769c2925f6ba849 Mon Sep 17 00:00:00 2001
From: Jolyon Brown <jolyon@limilo.com>
Date: Fri, 13 Nov 2026 05:01:43 +0000
Subject: [PATCH 21/40] Initialise the remaining members of InterCodeProcedure

The constructor left mLoadsIndirect, mStoresIndirect, mEntryBlock, the
frame and parameter sizes and a few flags unset.  mStoresIndirect is
read for a callee before its Close() has run (a recursive call:
InterCodeBasicBlock::DestroyingMem), so the generated code depended on
what the heap block held before.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 oscar64/InterCode.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/oscar64/InterCode.cpp b/oscar64/InterCode.cpp
index 62a6190..35d27ef 100644
--- a/oscar64/InterCode.cpp
+++ b/oscar64/InterCode.cpp
@@ -27720,7 +27720,12 @@ InterCodeProcedure::InterCodeProcedure(InterCodeModule * mod, const Location & l
 	mCheckUnreachable(true), mReturnType(IT_NONE), mCheapInline(false), mNoInline(false),
 	mDeclaration(nullptr), mGlobalsChecked(false), mDispatchedCall(false),
 	mIntrinsicFunction(false), mFuncVariable(false),
-	mNumRestricted(1)
+	mNumRestricted(1),
+	mEntryBlock(nullptr), mTempSize(0), mCommonFrameSize(0), mFreeCallerSavedTemps(0), mFastCallBase(0),
+	mHasDynamicStack(false), mHasInlineAssembler(false), mCallsByteCode(false),
+	mLocalSize(0), mNumLocals(0), mNumParams(0), mParamVarsSize(0),
+	mSection(nullptr), mCompilerOptions(0),
+	mLoadsIndirect(false), mStoresIndirect(false)
 {
 	mID = mModule->mProcedures.Size();
 	mModule->mProcedures.Push(this);
