 								{
-									// Check temp not used before load
+									// Check temp not used or modified before load, the load
+									// will read the value of the previous iteration from it
 									int k = 0;
-									while (k < i && !mInstructions[k]->UsesTemp(sins->mSrc[0].mTemp))
+									while (k < i && !mInstructions[k]->ReferencesTemp(sins->mSrc[0].mTemp))
 										k++;
 									if (k == i)
 									{
@@ -23285,10 +23286,11 @@ void InterCodeBasicBlock::SingleBlockLoopOptimisation(const NumberSet& aliasedPa
 										k = j + 1;
 										while (k < mInstructions.Size() && mInstructions[k]->mDst.mTemp != sins->mSrc[0].mTemp)
 											k++;
-										if (k == mInstructions.Size())
-										{
-											assert(!mEntryRequiredTemps[sins->mSrc[0].mTemp]);
 
+										// Check temp not needed with the value it has on entry, it
