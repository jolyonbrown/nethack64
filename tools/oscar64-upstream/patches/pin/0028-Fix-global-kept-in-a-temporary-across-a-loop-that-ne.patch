diff --git a/autotest/loopglobalforwardtest.c b/autotest/loopglobalforwardtest.c
new file mode 100644
index 0000000..5d70d14
--- /dev/null
+++ b/autotest/loopglobalforwardtest.c
@@ -0,0 +1,142 @@
+// A global variable that is read and later stored in every iteration of
+// a loop without calls is kept in the temporary of the stored value: the
+// global is loaded into it in front of the loop and stored back after
+// the loop.  That is only possible when the temporary has no other value
+// to carry at the point of the read: it must not be needed with the
+// value it has on entry to the loop, and it must not be assigned in
+// front of the read.
+
+#include <assert.h>
+
+char gv;
+int gi;
+char arr[4] = {1, 2, 3, 4};
+
+struct S
+{
+	char	a;
+	int		b;
+}	gs;
+
+// the stored value is a parameter that the loop needs on entry
+__noinline int store_param(char n)
+{
+	int r = 0;
+
+	gv = 5;
+	for (char i = 0; i < n; i++)
+	{
+		r += gv;
+		gv = n;
+	}
+
+	return r + gv;
+}
+
+// the stored value is computed in front of the loop
+__noinline int store_invariant(char n, char k)
+{
+	int r = 0;
+	char t = arr[k];
+
+	gv = 5;
+	for (char i = 0; i < n; i++)
+	{
+		r += gv;
+		gv = t;
+	}
+
+	return r + gv;
+}
+
+// the same with 16 bit variables
+__noinline int store_int(unsigned n)
+{
+	int r = 0;
+
+	gi = 500;
+	for (unsigned i = 0; i < n; i++)
+	{
+		r += gi;
+		gi = n;
+	}
+
+	return r + gi;
+}
+
+// a member of a global struct
+__noinline int store_member(unsigned n)
+{
+	int r = 0;
+
+	gs.b = 500;
+	for (unsigned i = 0; i < n; i++)
+	{
+		r += gs.b;
+		gs.b = n;
+	}
+
+	return r + gs.b;
+}
+
+// the stored value is assigned in the loop in front of the read of the
+// global, the store to the array keeps the two reads in this order
+__noinline int store_earlier(char n)
+{
+	int r = 0;
+
+	gv = 5;
+	for (char i = 0; i < n; i++)
+	{
+		char t = arr[i];
+
+		arr[i] = 9;
+		r += gv;
+		gv = t;
+	}
+
+	return r + gv;
+}
+
+// the stored value is assigned after the read: the global can be kept
+// in its temporary, the result must be the same
+__noinline int store_later(char n)
+{
+	int r = 0;
+
+	gv = 5;
+	for (char i = 0; i < n; i++)
+	{
+		r += gv;
+		gv = arr[i];
+	}
+
+	return r + gv;
+}
+
+int main(void)
+{
+	assert(store_param(0) == 5);
+	assert(store_param(1) == 5 + 1);
+	assert(store_param(3) == 5 + 3 + 3 + 3);
+
+	assert(store_invariant(0, 2) == 5);
+	assert(store_invariant(1, 2) == 5 + 3);
+	assert(store_invariant(3, 1) == 5 + 2 + 2 + 2);
+
+	assert(store_int(0) == 500);
+	assert(store_int(1) == 500 + 1);
+	assert(store_int(40) == 500 + 39 * 40 + 40);
+
+	assert(store_member(0) == 500);
+	assert(store_member(40) == 500 + 39 * 40 + 40);
+
+	assert(store_later(0) == 5);
+	assert(store_later(3) == 5 + 1 + 2 + 3);
+
+	assert(store_earlier(0) == 5);
+	assert(store_earlier(3) == 5 + 1 + 2 + 3);
+	assert(arr[0] == 9 && arr[2] == 9 && arr[3] == 4);
+
+	return 0;
+}
