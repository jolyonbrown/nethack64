From b74a007767b447fdab161befdec73eeb014b0e62 Mon Sep 17 00:00:00 2001
From: Jolyon Brown <jolyon@limilo.com>
Date: Sun, 22 Nov 2026 03:52:46 +0000
Subject: [PATCH 86/87] Two loads through one pointer: not swapped when the
 second loads the pointer

PeepholeReplaceOptimization() sorts two loads through the same pointer by offset,
and checked that the first does not overwrite the pointer but not that the second
does. In `for (; o; o = o->nobj) s += o->oclass;` it swapped the field's load
(offset 4) with `o = o->nobj` (offset 0), so the field came from the next object:
the first object skipped, the last read through null. -O1 and up, native code;
v1.32.273 and upstream main 08b01c9 (2026-11-21).

The swap now also needs the second load's destination to be neither the pointer
nor the first load's destination.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 oscar64/InterCode.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/oscar64/InterCode.cpp b/oscar64/InterCode.cpp
index 884e8937..ac5e3275 100644
--- a/oscar64/InterCode.cpp
+++ b/oscar64/InterCode.cpp
@@ -24525,11 +24525,16 @@ bool InterCodeBasicBlock::PeepholeReplaceOptimization(const GrowingVariableArray
 			{
 				// just skip it
 			}
+			// two loads through one pointer, sorted by offset; not when the second one loads a new
+			// value of the pointer (p->field then p = p->next: the field would come from the
+			// next object), nor into the same temporary
 			else if (mInstructions[i + 0]->mCode == IC_LOAD &&
 				mInstructions[i + 1]->mCode == IC_LOAD &&
 				mInstructions[i + 1]->mSrc[0].mTemp == mInstructions[i + 0]->mSrc[0].mTemp &&
 				mInstructions[i + 0]->mSrc[0].mIntConst > mInstructions[i + 1]->mSrc[0].mIntConst &&
 				mInstructions[i + 1]->mSrc[0].mTemp != mInstructions[i + 0]->mDst.mTemp &&
+				mInstructions[i + 1]->mDst.mTemp != mInstructions[i + 0]->mSrc[0].mTemp &&
+				mInstructions[i + 1]->mDst.mTemp != mInstructions[i + 0]->mDst.mTemp &&
 				!(mInstructions[i + 0]->mVolatile && mInstructions[i + 1]->mVolatile))
 			{
 				SwapInstructions(mInstructions[i + 0], mInstructions[i + 1]);
