diff --git a/autotest/elementforwardwalktest.c b/autotest/elementforwardwalktest.c
new file mode 100644
index 0000000..bd82736
--- /dev/null
+++ b/autotest/elementforwardwalktest.c
@@ -0,0 +1,161 @@
+#include <assert.h>
+
+// A value stored into an element of a local array is forwarded to the
+// uses of the element (CheckSingleUseGlobalLoadStruct), unless a path
+// overwrites the element in between.  A block first reached behind such
+// an overwrite is checked a second time when a path reaches it without
+// one.  That second check was repeated for every path, and the number of
+// paths through a run of independent conditionals doubles with every
+// conditional: element_chain took two or three times as long to compile
+// for every conditional added.  When the blocks behind the overwrite
+// formed a loop the check never came back: element_loop crashed the
+// compiler with a stack overflow.  Both in the native configurations
+// above -O0.
+//
+// The other functions are further shapes of the same check, with asserts
+// on the values: a compiler that forwards the value past the overwrite
+// fails element_loop_store.  The functions are called with more than one
+// argument value, so the arguments are not folded into them.
+
+#define CHAIN4(i) \
+	if (fl[i]) acc += 1; \
+	if (fl[i + 1]) acc += 2; \
+	if (fl[i + 2]) acc += 3; \
+	if (fl[i + 3]) acc += 4;
+
+#define CHAIN12 CHAIN4(0) CHAIN4(4) CHAIN4(8)
+#define CHAIN14 CHAIN12 if (fl[12]) acc += 1; if (fl[13]) acc += 2;
+
+char		fl[64];
+char		arr[8] = {10, 20, 30, 40, 50, 60, 70, 80};
+char		cb = 5;
+int		acc;
+
+__noinline void bump(void)
+{
+	acc++;
+}
+
+__noinline int use(char * p)
+{
+	return p[0] + p[1];
+}
+
+// The element is overwritten in one arm in front of the chain
+
+__noinline int element_chain(char k)
+{
+	char t[4];
+	t[1] = 1;
+	t[0] = arr[k];
+	int r = 0;
+	if (fl[63]) { r = use(t); t[0] = cb; r += use(t); }
+	CHAIN14
+	return r;
+}
+
+// As before, the element is read behind the chain
+
+__noinline int element_chain_read(char k)
+{
+	char t[4];
+	t[1] = 1;
+	t[0] = arr[k];
+	int r = 0;
+	if (fl[63]) { r = use(t); t[0] = cb; r += use(t); }
+	CHAIN4(0)
+	return r + t[0];
+}
+
+// The element is read before it is overwritten in one arm
+
+__noinline int element_read_chain(char k)
+{
+	char t[4];
+	t[1] = 1;
+	t[0] = arr[k];
+	int r = t[0];
+	if (fl[63]) t[0] = cb;
+	CHAIN4(0)
+	return r + use(t);
+}
+
+// A loop behind the overwrite that does not touch the element
+
+__noinline int element_loop(char k)
+{
+	char t[4];
+	t[1] = 1;
+	t[0] = arr[k];
+	int r = 0;
+	if (fl[63]) { r = use(t); t[0] = cb; r += use(t); }
+	for (char i = 0; i < k; i++) acc += fl[i];
+	return r;
+}
+
+// A loop behind the overwrite that overwrites the element again
+
+__noinline int element_loop_store(char k)
+{
+	char t[4];
+	t[1] = 1;
+	t[0] = arr[k];
+	int r = 0;
+	if (fl[63]) { r = use(t); t[0] = cb; r += use(t); }
+	CHAIN4(0)
+	for (char i = 0; i < k; i++) { if (fl[i + 8]) t[0] = i; bump(); }
+	return r + t[0];
+}
+
+// A second overwrite behind the chain
+
+__noinline int element_two_stores(char k)
+{
+	char t[4];
+	t[1] = 1;
+	t[0] = arr[k];
+	int r = 0;
+	if (fl[63]) { r = use(t); t[0] = cb; r += use(t); }
+	CHAIN4(0)
+	if (fl[62]) t[0] = 9;
+	CHAIN4(4)
+	bump();
+	return r + use(t);
+}
+
+int main(void)
+{
+	assert(element_chain(1) == 0);
+	assert(element_chain_read(1) == 20);
+	assert(element_read_chain(1) == 41);
+	assert(element_loop(3) == 0);
+	assert(element_loop_store(2) == 30);
+	assert(element_two_stores(2) == 31);
+	assert(acc == 3);
+
+	fl[1] = 1;
+	fl[5] = 1;
+	fl[9] = 1;
+	fl[63] = 1;
+	acc = 0;
+
+	assert(element_chain(2) == 31 + 6);
+	assert(element_chain_read(2) == 31 + 6 + 5);
+	assert(element_read_chain(2) == 30 + 6);
+	assert(element_loop(2) == 31 + 6);
+	assert(element_loop_store(2) == 31 + 6 + 1);
+	assert(acc == 6 + 2 + 2 + 1 + 4);
+
+	fl[62] = 1;
+	assert(element_two_stores(2) == 31 + 6 + 10);
+	fl[63] = 0;
+	assert(element_two_stores(2) == 10);
+	fl[62] = 0;
+	assert(element_two_stores(3) == 41);
+	fl[8] = 1;
+	assert(element_loop_store(2) == 1);
+	assert(element_loop_store(1) == 0);
+	assert(element_loop_store(0) == 10);
+
+	return 0;
+}
diff --git a/oscar64/NativeCodeGenerator.cpp b/oscar64/NativeCodeGenerator.cpp
index 686c59e..e9c8a01 100644
--- a/oscar64/NativeCodeGenerator.cpp
+++ b/oscar64/NativeCodeGenerator.cpp
@@ -34613,11 +34613,46 @@ bool NativeCodeBasicBlock::PatchSingleUseGlobalLoad(const NativeCodeBasicBlock*
 }
 
 
+bool NativeCodeBasicBlock::CheckSingleUseGlobalLoadStructLoop(const NativeCodeBasicBlock* block, const NativeCodeInstruction& rins, const NativeCodeBasicBlock* target, ExpandingArray<NativeCodeBasicBlock*>& visited)
+{
+	if (visited.IndexOf(this) != -1)
+		return false;
+	visited.Push(this);
+
+	if (this == block)
+		return false;
+
+	for (int i = 0; i < mIns.Size(); i++)
+	{
+		const NativeCodeInstruction& ins(mIns[i]);
+
+		if (ins.SameEffectiveAddress(rins) && (ins.mType == ASMIT_STA || ins.mType == ASMIT_STX || ins.mType == ASMIT_STY))
+			return mTrueJump == target || mFalseJump == target;
+	}
+
+	if (mTrueJump && mTrueJump->mPatchFail && mTrueJump->CheckSingleUseGlobalLoadStructLoop(block, rins, target, visited))
+		return true;
+	if (mFalseJump && mFalseJump->mPatchFail && mFalseJump->CheckSingleUseGlobalLoadStructLoop(block, rins, target, visited))
+		return true;
+
+	return false;
+}
+
 bool NativeCodeBasicBlock::CheckSingleUseGlobalLoadStruct(const NativeCodeBasicBlock* block, const NativeCodeInstruction& rins, int at, const NativeCodeInstruction& ains, bool cleared, bool poisoned)
 {
 	bool	ok = true;
-	if (!mPatched || mPatchFail && !cleared)
+
+	// A block first entered after an overwrite is checked a second time when
+	// a path reaches it without one, and that second check is needed once.
+	// Repeating it for every such path is exponential in the number of
+	// consecutive conditionals behind the block, and never ends when they
+	// form a loop.
+	if (!mPatched || mPatchFail && !cleared && !mPatchRecheck)
 	{
+		bool	recheck = mPatched;
+		if (recheck)
+			mPatchRecheck = true;
+
 		if (mPatchFail || this != block && !IsDominatedBy(block))
 			poisoned = true;
 
@@ -34668,6 +34703,28 @@ bool NativeCodeBasicBlock::CheckSingleUseGlobalLoadStruct(const NativeCodeBasicB
 		{
 			mPatchUsed = used || !cleared;
 
+			if (recheck)
+			{
+				// Repeated second checks of the blocks behind this one failed when
+				// one of them overwrites the variable and then leads back here while
+				// this check is still running. They are not repeated any more, so
+				// look for that case here: the overwriting block marks the blocks it
+				// leads to, and a marked block searches for it.
+				if (cleared)
+				{
+					if (mTrueJump && mTrueJump->mPatchFail && !mTrueJump->mPatchRecheck)
+						mTrueJump->mPatchRejoin = true;
+					if (mFalseJump && mFalseJump->mPatchFail && !mFalseJump->mPatchRecheck)
+						mFalseJump->mPatchRejoin = true;
+				}
+				else if (mPatchRejoin)
+				{
+					ExpandingArray<NativeCodeBasicBlock*>	visited;
+					if (CheckSingleUseGlobalLoadStructLoop(block, rins, this, visited))
+						return false;
+				}
+			}
+
 			if (mTrueJump && !mTrueJump->CheckSingleUseGlobalLoadStruct(block, rins, 0, ains, cleared, poisoned))
 				return false;
 			if (mFalseJump && !mFalseJump->CheckSingleUseGlobalLoadStruct(block, rins, 0, ains, cleared, poisoned))
@@ -34676,7 +34733,11 @@ bool NativeCodeBasicBlock::CheckSingleUseGlobalLoadStruct(const NativeCodeBasicB
 			mPatchUsed = used || (mTrueJump && mTrueJump->mPatchUsed) || (mFalseJump && mFalseJump->mPatchUsed);
 		}
 	}
-	else if ((mPatchUsed && (poisoned || cleared)))
+	// A block whose second check is still running has mPatchUsed set, and a
+	// completed second check has left it clear. Every arrival inside a second
+	// check is poisoned or cleared, so it fails here as it did before; the
+	// mPatchFail term is defensive and does not change the result.
+	else if (mPatchUsed && (poisoned || cleared || mPatchFail))
 		return false;
 
 	return true;
@@ -71459,6 +71520,8 @@ void NativeCodeProcedure::ResetPatched(void)
 		b->mPatched = false;
 		b->mPatchFail = false;
 		b->mPatchUsed = false;
+		b->mPatchRecheck = false;
+		b->mPatchRejoin = false;
 		b->mPatchChecked = false;
 		b->mPatchStart = false;
 		b->mPatchLoop = false;
