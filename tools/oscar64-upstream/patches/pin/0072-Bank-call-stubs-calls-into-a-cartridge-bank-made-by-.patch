From 7caff8d1f3c42abcfafd6bd9f02b52ede7d2e93f Mon Sep 17 00:00:00 2001
From: Jolyon Brown <jolyon@limilo.com>
Date: Sun, 15 Nov 2026 18:46:45 +0000
Subject: [PATCH 72/73] Bank call stubs: calls into a cartridge bank made by
 the linker

A program that names a bank call routine (#pragma runtime(bankcall, ...))
has every call into a cartridge bank from outside it, and every use of a
banked function's address, sent through a 6-byte stub in the resident
code section: jsr bankcall / .byte bank / .word function. Calls within a
bank stay direct; an address computed from a banked function's address is
the same offset into its stub. The pass runs after all of the compiler's
analysis, which saw the calls as they are written, so recursion and the
placement of fastcall parameters are unaffected; the routine has to leave
A, X, Y, the zero page and the software stack as it found them, both ways.
Byte code cannot call into a bank (the interpreter would run the stub as
byte code), and a call into the middle of another bank's code is an error.
The linker also warns of references to data placed in another bank (a
string literal goes into the code section in force where it is written).
A program without the pragma links as before.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 oscar64/Compiler.cpp |  25 ++++++++
 oscar64/Errors.h     |   2 +
 oscar64/Linker.cpp   | 145 ++++++++++++++++++++++++++++++++++++++++++-
 oscar64/Linker.h     |   3 +
 4 files changed, 174 insertions(+), 1 deletion(-)

diff --git a/oscar64/Compiler.cpp b/oscar64/Compiler.cpp
index ef8321b..a527bd9 100644
--- a/oscar64/Compiler.cpp
+++ b/oscar64/Compiler.cpp
@@ -1049,6 +1049,9 @@ bool Compiler::GenerateCode(void)
 
 	// Register native runtime functions
 
+	LinkerObject* bankCallObject = nullptr;
+	int bankCallOffset = 0;
+
 	if (mInterCodeModule->mProcedures.Size() > 0)
 	{
 		RegisterRuntime(loc, Ident::Unique("mul16by8"));
@@ -1094,6 +1097,25 @@ bool Compiler::GenerateCode(void)
 		RegisterRuntime(loc, Ident::Unique("malloc"));
 		RegisterRuntime(loc, Ident::Unique("free"));
 		RegisterRuntime(loc, Ident::Unique("breakpoint"));
+
+		// Optional: a program that names a bank call routine has its calls between
+		// cartridge banks go through it (Linker::InsertBankCalls)
+		Declaration* bkdec = mCompilationUnits->mRuntimeScope->Lookup(Ident::Unique("bankcall"));
+		if (bkdec && bkdec->mType == DT_CONST_ASSEMBLER)
+		{
+			if (!bkdec->mLinkerObject)
+				mInterCodeGenerator->TranslateAssembler(mInterCodeModule, bkdec, nullptr);
+			bankCallObject = bkdec->mLinkerObject;
+		}
+		else if (bkdec && bkdec->mType == DT_LABEL)
+		{
+			if (!bkdec->mBase->mLinkerObject)
+				mInterCodeGenerator->TranslateAssembler(mInterCodeModule, bkdec->mBase, nullptr);
+			bankCallObject = bkdec->mBase->mLinkerObject;
+			bankCallOffset = int(bkdec->mInteger);
+		}
+		else if (bkdec)
+			mErrors->Error(loc, EERR_RUNTIME_CODE, "Bank call routine must be assembler code", bkdec->mIdent);
 	}
 
 	// Register extended byte code functions
@@ -1232,6 +1254,9 @@ bool Compiler::GenerateCode(void)
 	for (int i = 0; i < mCompilationUnits->mReferenced.Size(); i++)
 		mLinker->ReferenceObject(mCompilationUnits->mReferenced[i]->mLinkerObject);
 
+	if (bankCallObject)
+		mLinker->InsertBankCalls(bankCallObject, bankCallOffset, mCompilationUnits->mSectionCode);
+
 	if (mCompilerOptions & COPT_OPTIMIZE_BASIC)
 	{
 		mLinker->CombineSameConst();
