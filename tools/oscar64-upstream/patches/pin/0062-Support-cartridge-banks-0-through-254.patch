+// Bank 255 is reserved for __bankof's "not in a single bank" result.
+class CartridgeBankSet
+{
+public:
+	static const int NUM_BANKS = 255;
+	static const int NO_BANK = 255;
+
+	CartridgeBankSet(void) : mBits{0, 0, 0, 0} {}
+
+	bool Empty(void) const
+	{
+		return !(mBits[0] | mBits[1] | mBits[2] | mBits[3]);
+	}
+
+	void Set(int bank)
+	{
+		if (bank >= 0 && bank < NUM_BANKS)
+			mBits[bank >> 6] |= 1ULL << (bank & 63);
+	}
+
+	bool Contains(int bank) const
+	{
+		return bank >= 0 && bank < NUM_BANKS &&
+			(mBits[bank >> 6] & (1ULL << (bank & 63))) != 0;
+	}
+
+	bool Intersects(const CartridgeBankSet& banks) const
+	{
+		for (int i = 0; i < 4; i++)
+			if (mBits[i] & banks.mBits[i])
+				return true;
+		return false;
+	}
+
+	bool operator == (const CartridgeBankSet& banks) const
+	{
+		for (int i = 0; i < 4; i++)
+			if (mBits[i] != banks.mBits[i])
+				return false;
+		return true;
+	}
+
+	bool operator != (const CartridgeBankSet& banks) const
+	{
+		return !(*this == banks);
+	}
+
+	// Iterate in ascending order, ending at NO_BANK.
+	int Next(int bank = -1) const
+	{
+		while (++bank < NUM_BANKS)
+			if (Contains(bank))
+				return bank;
+		return NO_BANK;
+	}
+
+	int Single(void) const
+	{
+		int bank = Next();
+		return Next(bank) == NO_BANK ? bank : NO_BANK;
+	}
+
+private:
+	uint64 mBits[4];
+};
