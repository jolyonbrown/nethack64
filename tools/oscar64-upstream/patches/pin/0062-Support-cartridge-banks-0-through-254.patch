diff --git a/autotest/bankofhigh.c b/autotest/bankofhigh.c
new file mode 100644
index 0000000..f139d0e
--- /dev/null
+++ b/autotest/bankofhigh.c
@@ -0,0 +1,50 @@
+#include <assert.h>
+
+#pragma section(bank0, 0)
+#pragma region(bank0, 0x8000, 0x8100, , 0, {bank0})
+#pragma section(bank63, 0)
+#pragma region(bank63, 0x8000, 0x8100, , 63, {bank63})
+#pragma section(bank64, 0)
+#pragma region(bank64, 0x8000, 0x8100, , 64, {bank64})
+#pragma section(bank127, 0)
+#pragma region(bank127, 0x8000, 0x8100, , 127, {bank127})
+#pragma section(bank200, 0)
+#pragma region(bank200, 0x8000, 0x8100, , 200, {bank200})
+#pragma section(bank254, 0)
+#pragma region(bank254, 0x8000, 0x8100, , 254, {bank254})
+#pragma section(shared, 0)
+#pragma region(shared, 0x8100, 0x8200, , {0, 64, 127, 254}, {shared})
+// Reordering or repeating banks must not change the region definition.
+#pragma region(shared, 0x8100, 0x8200, , {254, 127, 64, 0, 64}, {shared})
+
+#pragma data(bank0)
+char value0 = 0;
+#pragma data(bank63)
+char value63 = 0;
+#pragma data(bank64)
+char value64 = 0;
+#pragma data(bank127)
+char value127 = 0;
+#pragma data(bank200)
+char value200 = 0;
+#pragma data(bank254)
+char value254 = 0;
+#pragma data(shared)
+char valueShared = 0;
+#pragma data(data)
+char valueResident = 0;
+
+// Only resident code is executed: the emulator has no cartridge mapper.
+int main(void)
+{
+	assert(__bankof(value0) == 0);
+	assert(__bankof(value63) == 63);
+	assert(__bankof(value64) == 64);
+	assert(__bankof(value127) == 127);
+	assert(__bankof(value200) == 200);
+	assert(__bankof(value254) == 254);
+	assert(__bankof(valueShared) == 0xff);
+	assert(__bankof(valueResident) == 0xff);
+	assert(__bankof(0) == 0xff);
+	return 0;
+}
