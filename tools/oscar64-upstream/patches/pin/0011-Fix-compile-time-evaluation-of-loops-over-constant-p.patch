From 51729f29918f4c4d3d8920eb07a21b809b60da23 Mon Sep 17 00:00:00 2001
From: Jolyon Brown <jolyon@limilo.com>
Date: Thu, 12 Nov 2026 14:12:59 +0000
Subject: [PATCH 11/32] Fix compile time evaluation of loops over constant
 pointer tables

A loop that reads pointers from a constant table and that the optimizer
can run at compile time crashed the compiler:

    static const char * const names[] = { "Alpha", "Beta", "Gamma", 0 };
    int n;
    for (n = 0; names[n]; n++)
        ;

ConstSingleLoopOptimization and ConstInnerLoopOptimization evaluate
the loads through LoadConstantOperand.  Its IT_POINTER case was copied
from LoadConstantFold, where the result is written into ins->mConst, so
it still read the operand size from ins->mConst.mLinkerObject.  Here the
result is built in the local operand cop and ins is the load instruction,
whose unused constant operand has no linker object: a null dereference.
Take the size from cop.mLinkerObject, the object the reference names,
as LoadConstantFold does.

With that corrected, the same loop ran to the wrong count: both loop
evaluators decide an IC_BRANCH by mIntConst alone, and a pointer to a
global at offset 0 has mIntConst 0 while it is not null.  Decide the
branch the way CheckIsConstBranch already does: a pointer is true when
it names a global or procedure or has a non zero offset; a float by its
float value.  Both loop evaluators take that test from the new helper
OperandConstantIsTrue; nothing else changes.

Test: autotest/constloopptrtest.c runs single block and multi block
loops over null terminated tables of strings, functions and addresses
of globals and over a struct table with a pointer member, and uses the
pointers the loops end on.  It crashed the compiler at every level
except -O0.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 autotest/autotest.bat       |   3 +
 autotest/constloopptrtest.c | 154 ++++++++++++++++++++++++++++++++++++
 oscar64/InterCode.cpp       |  19 ++++-
 3 files changed, 173 insertions(+), 3 deletions(-)
 create mode 100644 autotest/constloopptrtest.c

diff --git a/autotest/autotest.bat b/autotest/autotest.bat
index 37c48c1..0871c81 100644
--- a/autotest/autotest.bat
+++ b/autotest/autotest.bat
@@ -204,6 +204,9 @@ rem @echo off
 @call :test loopdomtest.c
 @if %errorlevel% neq 0 goto :error
 
+@call :test constloopptrtest.c
+@if %errorlevel% neq 0 goto :error
+
 @call :test loopboundtest.c
 @if %errorlevel% neq 0 goto :error
 
diff --git a/autotest/constloopptrtest.c b/autotest/constloopptrtest.c
new file mode 100644
index 0000000..081be15
--- /dev/null
+++ b/autotest/constloopptrtest.c
@@ -0,0 +1,154 @@
+#include <assert.h>
+#include <string.h>
+
+// Loops over constant tables that the compiler can run at compile time
+// (ConstSingleLoopOptimization, ConstInnerLoopOptimization) and that load
+// pointers from the table: strings, struct members, functions and the
+// addresses of globals.
+
+static const char * const names[] = { "Alpha", "Beta", "Gamma", "Delta", 0 };
+
+struct shop
+{
+	const char *	name;
+	char			symb;
+	int				prob;
+};
+
+static const struct shop shops[] = {
+	{ "general", '=', 42 },
+	{ "book",    '+', 10 },
+	{ "candle",  '(',  5 },
+	{ 0, 0, 0 }
+};
+
+int count_names(void)
+{
+	int n;
+	for (n = 0; names[n]; n++)
+		;
+	return n;
+}
+
+const char * last_name(void)
+{
+	int n;
+	for (n = 0; names[n + 1]; n++)
+		;
+	return names[n];
+}
+
+int walk_names(void)
+{
+	const char * const * p;
+	int n = 0;
+	for (p = names; *p; p++)
+		n++;
+	return n;
+}
+
+int count_shops(void)
+{
+	int n;
+	for (n = 0; shops[n].name; n++)
+		;
+	return n;
+}
+
+int total_prob(void)
+{
+	int p = 0;
+	for (int i = 0; shops[i].name; i++)
+		p += shops[i].prob;
+	return p;
+}
+
+int find_shop(char symb)
+{
+	int i;
+	for (i = 0; shops[i].name && shops[i].symb != symb; i++)
+		;
+	return i;
+}
+
+int one(void) { return 11; }
+int two(void) { return 22; }
+int three(void) { return 33; }
+
+typedef int (*func)(void);
+
+static const func funcs[] = { one, two, three, 0 };
+
+int count_funcs(void)
+{
+	int n;
+	for (n = 0; funcs[n]; n++)
+		;
+	return n;
+}
+
+func last_func(void)
+{
+	int n;
+	for (n = 0; funcs[n + 1]; n++)
+		;
+	return funcs[n];
+}
+
+int values[8] = { 1, 2, 3, 4, 5, 6, 7, 8 };
+
+static int * const refs[] = { values + 2, values, values + 7, 0 };
+
+int * last_ref(void)
+{
+	int n;
+	for (n = 0; refs[n + 1]; n++)
+		;
+	return refs[n];
+}
+
+// Loops of more than one block, with null entries inside the table
+
+static const char * const sparse[] = { "Alpha", 0, "Gamma", "Delta", 0, "Zeta" };
+
+int count_sparse(void)
+{
+	int n = 0;
+	for (int i = 0; i < 6; i++)
+	{
+		if (sparse[i])
+			n++;
+	}
+	return n;
+}
+
+int weigh_sparse(void)
+{
+	int n = 0;
+	for (int i = 0; i < 6; i++)
+	{
+		if (sparse[i])
+			n += 3;
+		else
+			n += 100;
+	}
+	return n;
+}
+
+int main(void)
+{
+	assert(count_names() == 4);
+	assert(!strcmp(last_name(), "Delta"));
+	assert(walk_names() == 4);
+	assert(count_shops() == 3);
+	assert(total_prob() == 57);
+	assert(find_shop('+') == 1);
+	assert(find_shop('?') == 3);
+	assert(count_funcs() == 3);
+	assert(last_func()() == 33);
+	assert(last_ref() == values + 7);
+	assert(*last_ref() == 8);
+	assert(count_sparse() == 4);
+	assert(weigh_sparse() == 212);
+	return 0;
+}
diff --git a/oscar64/InterCode.cpp b/oscar64/InterCode.cpp
index eb38ca8..8d70910 100644
--- a/oscar64/InterCode.cpp
+++ b/oscar64/InterCode.cpp
@@ -1912,6 +1912,19 @@ static void ConversionConstantFold(InterInstruction * ins, const InterOperand &
 	}
 }
 
+// Truth value of a constant operand used as a branch condition, as in
+// CheckIsConstBranch: a pointer into a global or to a procedure is not
+// null, whatever its offset.
+static bool OperandConstantIsTrue(const InterOperand& op)
+{
+	if (op.mType == IT_FLOAT)
+		return op.mFloatConst != 0;
+	else if (op.mType == IT_POINTER)
+		return op.mMemory != IM_ABSOLUTE || op.mIntConst != 0;
+	else
+		return op.mIntConst != 0;
+}
+
 static InterOperand OperandConstantFolding(InterOperator oper, InterOperand op1, InterOperand op2)
 {
 	InterOperand	dop;
@@ -2259,7 +2272,7 @@ InterOperand InterCodeBasicBlock::LoadConstantOperand(const InterInstruction* in
 
 				cop.mLinkerObject = lobj->mReferences[i]->mRefObject;
 				cop.mIntConst = lobj->mReferences[i]->mRefOffset;
-				cop.mOperandSize = ins->mConst.mLinkerObject->mSize;
+				cop.mOperandSize = cop.mLinkerObject->mSize;
 			}
 			else
 			{
@@ -19736,7 +19749,7 @@ void InterCodeBasicBlock::ConstInnerLoopOptimization(void)
 								break;
 
 							case IC_BRANCH:
-								block = vars[ins->mSrc[0].mTemp].mIntConst ? block->mTrueJump : block->mFalseJump;
+								block = OperandConstantIsTrue(vars[ins->mSrc[0].mTemp]) ? block->mTrueJump : block->mFalseJump;
 								ni = 0;
 								if (!body.Contains(block))
 									done = true;
@@ -19945,7 +19958,7 @@ void InterCodeBasicBlock::ConstSingleLoopOptimization(void)
 						}	break;
 
 						case IC_BRANCH:
-							if ((vars[ins->mSrc[0].mTemp].mIntConst ? mTrueJump : mFalseJump) != this)
+							if ((OperandConstantIsTrue(vars[ins->mSrc[0].mTemp]) ? mTrueJump : mFalseJump) != this)
 								done = true;
 							break;
 						}
