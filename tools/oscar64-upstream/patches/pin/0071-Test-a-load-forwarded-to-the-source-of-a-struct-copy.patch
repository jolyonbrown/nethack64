From 893f954d7e83f00590c87c53fe2ed73a84252d51 Mon Sep 17 00:00:00 2001
From: Jolyon Brown <jolyon@limilo.com>
Date: Sun, 15 Nov 2026 18:58:20 +0000
Subject: [PATCH 71/73] Test a load forwarded to the source of a struct copy

Co-Authored-By: Claude <noreply@anthropic.com>
---
 autotest/copyforwardbasetest.c | 53 ++++++++++++++++++++++++++++++++++
 1 file changed, 53 insertions(+)
 create mode 100644 autotest/copyforwardbasetest.c

diff --git a/autotest/copyforwardbasetest.c b/autotest/copyforwardbasetest.c
new file mode 100644
index 0000000..9eee364
--- /dev/null
+++ b/autotest/copyforwardbasetest.c
@@ -0,0 +1,53 @@
+#include <assert.h>
+
+// A struct copied from a pointer into a local, whose loads the optimizer reads from the
+// copy's source instead: the forwarded load must say it reads through that pointer.
+// It kept the local as its memory base, with no variable index, and the load/store
+// forwarding at the next call read the local variable table at index -1 (r64).
+
+typedef struct { signed char dnum, dlevel; } d_level;
+typedef struct s_level { struct s_level *next; d_level dlevel; char proto[15]; } s_level;
+
+s_level levs[3];
+volatile int vn;
+
+__noinline int ledger(d_level *lev) { return lev->dnum * 10 + lev->dlevel; }
+__noinline s_level *find(int n) { return &levs[n]; }
+__noinline int depthof(d_level *lev) { return lev->dlevel; }
+
+__noinline int lev_by(int n)
+{
+	s_level *slev = find(n);
+	d_level dlev;
+
+	dlev = slev->dlevel;
+	int idx = ledger(&dlev);
+	int a = dlev.dnum;
+	int b = depthof(&slev->dlevel);
+	return a * 100 + b + idx;
+}
+
+// The source changes after the copy: the local keeps the old value
+__noinline int copy_then_store(int n)
+{
+	s_level *slev = find(n);
+	d_level dlev;
+
+	dlev = slev->dlevel;
+	int idx = ledger(&dlev);
+	slev->dlevel.dnum = 7;
+	int a = dlev.dnum;
+	int b = depthof(&slev->dlevel);
+	return a * 100 + b + idx;
+}
+
+int main(void)
+{
+	levs[1].dlevel.dnum = 2;
+	levs[1].dlevel.dlevel = 5;
+	vn = 1;
+	assert(lev_by(vn) == 200 + 5 + 25);
+	assert(copy_then_store(vn) == 200 + 5 + 25);
+	assert(levs[1].dlevel.dnum == 7);
+	return 0;
+}
