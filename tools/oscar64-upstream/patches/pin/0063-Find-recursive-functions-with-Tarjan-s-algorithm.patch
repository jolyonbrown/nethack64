diff --git a/oscar64/GlobalAnalyzer.cpp b/oscar64/GlobalAnalyzer.cpp
index d9b147d..cf6ec4e 100644
--- a/oscar64/GlobalAnalyzer.cpp
+++ b/oscar64/GlobalAnalyzer.cpp
@@ -359,41 +359,95 @@ void GlobalAnalyzer::AutoInline(void)
 
 }
 
-bool GlobalAnalyzer::MarkCycle(Declaration* rootDec, Declaration* procDec)
+void GlobalAnalyzer::MarkRecursions(void)
 {
-	if (rootDec == procDec)
-		return true;
+	// A function is recursive when it lies on a cycle of the call graph: when it shares
+	// a strongly connected component with another function, or calls itself.  Tarjan's
+	// algorithm finds the components in one walk of the graph.  Searching every simple
+	// path from each function back to itself marks the same functions, but takes time
+	// exponential in the number of cycles in a large program.
 
-	if (!(procDec->mFlags & DTF_FUNC_ANALYZING))
-	{
-		procDec->mFlags |= DTF_FUNC_ANALYZING;
+	GrowingArray<Declaration*>	stack(nullptr), work(nullptr);
+	GrowingArray<int>			next(0);
+	int							index = 0;
 
-		bool	cycle = false;
-		for (int i = 0; i < procDec->mCalled.Size(); i++)
+	for (int i = 0; i < mFunctions.Size(); i++)
+	{
+		Declaration* f = mFunctions[i];
+		f->mRecursionIndex = -1;
+		f->mRecursionStacked = false;
+		for (int j = 0; j < f->mCalled.Size(); j++)
 		{
-			if (MarkCycle(rootDec, procDec->mCalled[i]))
-				cycle = true;
+			f->mCalled[j]->mRecursionIndex = -1;
+			f->mCalled[j]->mRecursionStacked = false;
 		}
-		if (cycle)
-			procDec->mFlags |= DTF_FUNC_RECURSIVE;
-
-		procDec->mFlags &= ~DTF_FUNC_ANALYZING;
-
-		return cycle;
 	}
 
-	return false;
-}
-
-void GlobalAnalyzer::MarkRecursions(void)
-{
 	for (int i = 0; i < mFunctions.Size(); i++)
 	{
-		Declaration* cf = mFunctions[i];
-		for (int j = 0; j < cf->mCalled.Size(); j++)
+		Declaration* root = mFunctions[i];
+		if (root->mRecursionIndex >= 0)
+			continue;
+
+		root->mRecursionIndex = root->mRecursionLow = index++;
+		root->mRecursionStacked = true;
+		stack.Push(root);
+		work.Push(root);
+		next.Push(0);
+
+		while (work.Size() > 0)
 		{
-			if (MarkCycle(cf, cf->mCalled[j]))
-				cf->mFlags |= DTF_FUNC_RECURSIVE;
+			int			top = work.Size() - 1;
+			Declaration* v = work[top];
+			int			k = next[top];
+
+			if (k < v->mCalled.Size())
+			{
+				next[top] = k + 1;
+				Declaration* w = v->mCalled[k];
+
+				if (w == v)
+					v->mFlags |= DTF_FUNC_RECURSIVE;
+
+				if (w->mRecursionIndex < 0)
+				{
+					w->mRecursionIndex = w->mRecursionLow = index++;
+					w->mRecursionStacked = true;
+					stack.Push(w);
+					work.Push(w);
+					next.Push(0);
+				}
+				else if (w->mRecursionStacked && w->mRecursionIndex < v->mRecursionLow)
+					v->mRecursionLow = w->mRecursionIndex;
+			}
+			else
+			{
+				work.Pop();
+				next.Pop();
+
+				if (work.Size() > 0)
+				{
+					Declaration* u = work[work.Size() - 1];
+					if (v->mRecursionLow < u->mRecursionLow)
+						u->mRecursionLow = v->mRecursionLow;
+				}
+
+				if (v->mRecursionLow == v->mRecursionIndex)
+				{
+					// v roots a component: it is the part of the stack from v up
+					int	n = stack.Size() - 1;
+					while (stack[n] != v)
+						n--;
+					bool	cycle = n < stack.Size() - 1;
+					while (stack.Size() > n)
+					{
+						Declaration* w = stack.Pop();
+						w->mRecursionStacked = false;
+						if (cycle)
+							w->mFlags |= DTF_FUNC_RECURSIVE;
+					}
+				}
+			}
 		}
 	}
 }
