 	bool IsStackParam(const Declaration* pdec) const;
-	bool MarkCycle(Declaration* rootDec, Declaration* procDec);
 
 	uint64 GetProcFlags(Declaration* to) const;
 	void RegisterCall(Declaration* from, Declaration* to);
