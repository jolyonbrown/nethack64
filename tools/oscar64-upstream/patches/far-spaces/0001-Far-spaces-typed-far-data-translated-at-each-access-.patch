+// The far space a memory operand reaches, 0 if near.  An object in a far section is far
+// whatever the type said; an object known to be near (a global elsewhere, a local) needs
+// no translation even if its type is far (#pragma farspace's identity window: a near
+// object of a far type is at its own address); an address not known is far by its type.
+static int FarSpaceOfOperand(const InterOperand& op)
+{
+	if (op.mMemory == IM_GLOBAL)
+		return (op.mLinkerObject && op.mLinkerObject->mSection) ? op.mLinkerObject->mSection->mFarSpace : 0;
+	else if (op.mMemory == IM_INDIRECT)
+	{
+		if (op.mMemoryBase == IM_GLOBAL && op.mLinkerObject && op.mLinkerObject->mSection)
+			return op.mLinkerObject->mSection->mFarSpace;
+		if (op.mMemoryBase == IM_LOCAL || op.mMemoryBase == IM_PARAM || op.mMemoryBase == IM_FPARAM || op.mMemoryBase == IM_FRAME || op.mMemoryBase == IM_FFRAME)
+			return 0;
+		return op.mFarSpace;
+	}
+	return 0;
+}
+
+// Before an access to far data: t = FARXLAT(address), the access then through t.  Placed
+// right before the access, after every pass that moves instructions, so that nothing comes
+// between the two that could translate (and so fault and evict) another page, except in a
+// copy between two far objects, whose two translations follow each other: the runtime's
+// fault handler keeps the page it translated last.
+static void LowerFarOperand(InterCodeProcedure* proc, GrowingInstructionArray& instructions, int& i, InterOperand& op, int space)
+{
+	InterInstruction* ins = instructions[i];
+	int atemp;
+
+	if (op.mMemory == IM_GLOBAL)
+	{
+		if (op.mTemp >= 0)
+		{
+			InterInstruction* lins = new InterInstruction(ins->mLocation, IC_LEA);
+			lins->mSrc[1].mMemory = IM_GLOBAL;
+			lins->mSrc[1].mType = IT_POINTER;
+			lins->mSrc[1].mLinkerObject = op.mLinkerObject;
+			lins->mSrc[1].mVarIndex = op.mVarIndex;
+			lins->mSrc[1].mIntConst = op.mIntConst;
+			lins->mSrc[1].mOperandSize = op.mOperandSize;
+			lins->mSrc[0].mType = IT_INT16;
+			lins->mSrc[0].mTemp = op.mTemp;
+			lins->mNumOperands = 2;
+			lins->mDst.mType = IT_POINTER;
+			lins->mDst.mTemp = proc->AddTemporary(IT_POINTER);
+			instructions.Insert(i++, lins);
+			atemp = lins->mDst.mTemp;
+		}
+		else
+		{
+			InterInstruction* cins = new InterInstruction(ins->mLocation, IC_CONSTANT);
+			cins->mConst.mType = IT_POINTER;
+			cins->mConst.mMemory = IM_GLOBAL;
+			cins->mConst.mLinkerObject = op.mLinkerObject;
+			cins->mConst.mVarIndex = op.mVarIndex;
+			cins->mConst.mIntConst = op.mIntConst;
+			cins->mConst.mOperandSize = op.mOperandSize;
+			cins->mNumOperands = 0;
+			cins->mDst.mType = IT_POINTER;
+			cins->mDst.mTemp = proc->AddTemporary(IT_POINTER);
+			instructions.Insert(i++, cins);
+			atemp = cins->mDst.mTemp;
+		}
+	}
+	else if (op.mIntConst != 0)
+	{
+		// the exact address: a pointer to one object may carry the offset of the next
+		InterInstruction* lins = new InterInstruction(ins->mLocation, IC_LEA);
+		lins->mSrc[1].mMemory = IM_INDIRECT;
+		lins->mSrc[1].mType = IT_POINTER;
+		lins->mSrc[1].mTemp = op.mTemp;
+		lins->mSrc[0].mType = IT_INT16;
+		lins->mSrc[0].mTemp = -1;
+		lins->mSrc[0].mIntConst = op.mIntConst;
+		lins->mNumOperands = 2;
+		lins->mDst.mType = IT_POINTER;
+		lins->mDst.mTemp = proc->AddTemporary(IT_POINTER);
+		instructions.Insert(i++, lins);
+		atemp = lins->mDst.mTemp;
+	}
+	else
+		atemp = op.mTemp;
+
+	InterInstruction* xins = new InterInstruction(ins->mLocation, IC_UNARY_OPERATOR);
+	xins->mOperator = IA_FARXLAT;
+	xins->mSrc[0].mType = IT_POINTER;
+	xins->mSrc[0].mTemp = atemp;
+	xins->mConst.mType = IT_INT8;
+	xins->mConst.mIntConst = space;
+	xins->mNumOperands = 1;
+	xins->mDst.mType = IT_POINTER;
+	xins->mDst.mTemp = proc->AddTemporary(IT_POINTER);
+	instructions.Insert(i++, xins);
+
+	op.mMemory = IM_INDIRECT;
+	op.mMemoryBase = IM_NONE;
+	op.mTemp = xins->mDst.mTemp;
+	op.mIntConst = 0;
+	op.mLinkerObject = nullptr;
+	op.mVarIndex = -1;
+	op.mFarSpace = 0;
+	op.mRestricted = 0;
+}
+
+bool InterCodeBasicBlock::LowerFarAccesses(void)
+{
+	bool	changed = false;
+
+	if (!mVisited)
+	{
+		mVisited = true;
+
+		for (int i = 0; i < mInstructions.Size(); i++)
+		{
+			InterInstruction* ins = mInstructions[i];
+			int s0 = 0, s1 = 0;
+
+			switch (ins->mCode)
+			{
+			case IC_LOAD:
+				s0 = FarSpaceOfOperand(ins->mSrc[0]);
+				break;
+			case IC_STORE:
+			case IC_FILL:
+				s1 = FarSpaceOfOperand(ins->mSrc[1]);
+				break;
+			case IC_COPY:
+			case IC_STRCPY:
+				s0 = FarSpaceOfOperand(ins->mSrc[0]);
+				s1 = FarSpaceOfOperand(ins->mSrc[1]);
+				break;
+			}
+
+			if (s0 || s1)
+			{
+				if (ins->mVolatile)
+					mProc->mModule->mErrors->Error(ins->mLocation, EERR_INCOMPATIBLE_TYPES, "Volatile access to far data");
+				if (s0)
+					LowerFarOperand(mProc, mInstructions, i, ins->mSrc[0], s0);
+				if (s1)
+					LowerFarOperand(mProc, mInstructions, i, ins->mSrc[1], s1);
+				changed = true;
+			}
+		}
+
+		if (mTrueJump && mTrueJump->LowerFarAccesses()) changed = true;
+		if (mFalseJump && mFalseJump->LowerFarAccesses()) changed = true;
+	}
+
+	return changed;
+}
