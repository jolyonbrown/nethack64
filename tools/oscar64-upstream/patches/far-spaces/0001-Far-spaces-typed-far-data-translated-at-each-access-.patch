+// #pragma farspace(n, tag, ...): the struct and union tags of far spaces
+static ExpandingArray<const Ident*>	FarSpaceTags;
+static ExpandingArray<int>			FarSpaceIds;
+
+void SetFarSpace(const Ident* tag, int space)
+{
+	for (int i = 0; i < FarSpaceTags.Size(); i++)
+	{
+		if (FarSpaceTags[i] == tag)
+		{
+			FarSpaceIds[i] = space;
+			return;
+		}
+	}
+	FarSpaceTags.Push(tag);
+	FarSpaceIds.Push(space);
+}
+
+int Declaration::FarSpace(void) const
+{
+	const Declaration* dec = this;
+	while (dec && dec->mType == DT_TYPE_ARRAY)
+		dec = dec->mBase;
+	if (dec && (dec->mType == DT_TYPE_STRUCT || dec->mType == DT_TYPE_UNION) && dec->mIdent)
+	{
+		for (int i = 0; i < FarSpaceTags.Size(); i++)
+			if (FarSpaceTags[i] == dec->mIdent)
+				return FarSpaceIds[i];
+	}
+	return 0;
+}
