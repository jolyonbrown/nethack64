From 5b9eaa042bc76184d52aeb79410507a0563bb36a Mon Sep 17 00:00:00 2001
From: Jolyon Brown <jolyon@limilo.com>
Date: Mon, 23 Nov 2026 02:58:34 +0000
Subject: [PATCH] Far spaces: an access through a pointer variable is
 translated

FarSpaceOfOperand() kept an access near when its memory base was a
local or parameter variable, for an object on the stack (a near local
of a far type). But the alias pass gives a pointer loaded from such a
variable the variable's own base, so an access through a pointer
parameter on the stack could be left untranslated too: nethack64's
save_room(), "for(i=0; i<r->nsubrooms; i++) save_room(fd,
r->sbrooms[i]);", read r->nsubrooms and r->sbrooms[i] at the far
address in RAM, and recursed through garbage until the hardware stack
wrapped. The base still keeps an access near when the variable is the
object; when the variable is a pointer, the access takes the far space
of what it points at. Declaration.h is included for the variable's
type.

A whole-game diagnostic build listed what the rule had left near: 179
accesses, all that had a far space; those with a parameter base were
real (save_room, stock_room, fill_zoo: rooms; dog_move, mfndpos,
find_misc, select_rwep: monsters; gold_detect, carry_count, seffects:
objects); those with a global or local base were near char arrays,
correctly near.

autotest/farloopfieldtest.c: the save_room() shape on a far struct
(it does not get the alias base on its own, so it guards the case
rather than reproducing it). make check: 1,706 of 1,706, no new
failures against commit 20's, and the new test 5 of 5.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 autotest/farloopfieldtest.c | 125 ++++++++++++++++++++++++++++++++++++
 autotest/makefile           |   7 ++
 oscar64/InterCode.cpp       |  38 ++++++++---
 3 files changed, 161 insertions(+), 9 deletions(-)
 create mode 100644 autotest/farloopfieldtest.c

diff --git a/autotest/farloopfieldtest.c b/autotest/farloopfieldtest.c
new file mode 100644
index 0000000..9f31018
--- /dev/null
+++ b/autotest/farloopfieldtest.c
@@ -0,0 +1,125 @@
+/* A far struct's fields read in a loop after a call that takes the pointer (nethack64:
+ * mkroom.c's save_room(), "for(i=0; i<r->nsubrooms; i++) save_room(fd, r->sbrooms[i]);"
+ * after nh_farbwrite4(fd, r, ...)). Runtime as in farbitfieldtest.c. Native code only. */
+#include <string.h>
+
+#pragma farspace(1, room)
+
+#pragma section(fardata, 0)
+#pragma farsection(fardata, 1)
+#pragma region(farr, 0x8000, 0x9000, , , { fardata })
+#pragma region(main, 0x0900, 0x8000, , , { code, data, bss, heap, stack })
+
+
+/* the space's page table: far page p at RAM page p + $10 */
+unsigned char tlb1[256];
+
+__asm farxl1
+{
+		lda tlb1, x
+		rts
+}
+#pragma runtime(farxl1, farxl1)
+
+#ifdef FARXZ
+/* the far pointer at the zero page address in X, translated into ADDR (page in A too),
+   Y kept: with it the compiler calls this for a page instead of farxl1 */
+__asm farxz1
+{
+		lda $00, x
+		sta __addr + 0
+		lda $01, x
+		tax
+		lda tlb1, x
+		sta __addr + 1
+		rts
+}
+#pragma runtime(farxz1, farxz1)
+#endif
+
+/* the address in A and X plus the offset in Y, translated: A and X */
+unsigned char xoff, xlo;
+
+__asm farxo1
+{
+		sty xoff
+		clc
+		adc xoff
+		bcc nc
+		inx
+nc:		sta xlo
+		lda tlb1, x
+		tax
+		lda xlo
+		rts
+}
+#pragma runtime(farxo1, farxo1)
+
+/* the pin slots: a group's translation stores its page here (no faults in this test) */
+unsigned char farpins[4];
+#pragma runtime(farpins, farpins)
+
+struct room {
+	signed char lx, hx, ly, hy, rtype, rlit, doorct, fdoor, nsub;
+	char irregular;
+	struct room *sb[24];
+	void *resident;
+	unsigned char pad[4];
+};
+
+#pragma data(fardata)
+struct room rooms[4], subrooms[4];
+#pragma data(data)
+
+int calls, total, nroom = 2;
+
+struct blk { unsigned char b; };
+#pragma farspace(1, blk)
+
+__noinline void sink2(int fd, unsigned n)
+{
+	total += fd + n;
+}
+
+__noinline void sink(int fd, const struct blk *p, unsigned n)
+{
+	if (p)
+		total += p->b;
+	sink2(fd, n);
+}
+
+static void save_room(int fd, struct room *r)
+{
+	short i;
+	calls++;
+	sink(fd, (const struct blk *) r, sizeof(struct room));
+	for (i = 0; i < r->nsub; i++)
+		save_room(fd, r->sb[i]);
+}
+
+__noinline void save_rooms(int fd)
+{
+	short i;
+	sink(fd, (const struct blk *) 0, sizeof(nroom));
+	for (i = 0; i < nroom; i++)
+		save_room(fd, &rooms[i]);
+}
+
+int main(void)
+{
+	for (int i = 0; i < 256; i++)
+		tlb1[i] = i;
+	for (int i = 0x80; i < 0x90; i++)
+		tlb1[i] = i + 0x10;
+	rooms[0].lx = 1; rooms[0].nsub = 2; rooms[0].sb[0] = &subrooms[0]; rooms[0].sb[1] = &subrooms[1];
+	rooms[1].lx = 2;
+	subrooms[0].lx = 3; subrooms[0].nsub = 1; subrooms[0].sb[0] = &subrooms[2];
+	subrooms[2].lx = 4;
+	memcpy((char *)0x9000, (char *)0x8000, 0x1000);
+	memset((char *)0x8000, 0x05, 0x1000);	/* nsub 5 read untranslated: runaway */
+
+	calls = 0;
+	save_rooms(7);
+	/* rooms 0, its subrooms 0 and 2 and 1, room 1: five calls */
+	return calls == 5 ? 0 : (calls > 99 ? 99 : calls);
+}
diff --git a/autotest/makefile b/autotest/makefile
index bd2d822..6cf941a 100644
--- a/autotest/makefile
+++ b/autotest/makefile
@@ -76,6 +76,13 @@ farcharstest: farcharstest.c
 	$(OSCAR64_CC) -ea -g -Os -n -dFARXZ -dOSCAR_FARCHARS $<
 	$(OSCAR64_CC) -ea -g -O3 -n -dFARXZ -dOSCAR_FARCHARS $<
 
+farloopfieldtest: farloopfieldtest.c
+	$(OSCAR64_CC) -ea -g -O0 -n $<
+	$(OSCAR64_CC) -ea -g -Os -n $<
+	$(OSCAR64_CC) -ea -g -Os -n -dFARXZ $<
+	$(OSCAR64_CC) -ea -g -O2 -n -dFARXZ $<
+	$(OSCAR64_CC) -ea -g -O3 -n $<
+
 farcondtest: farcondtest.c
 	$(OSCAR64_CC) -ea -g -O0 -n $<
 	$(OSCAR64_CC) -ea -g -O1 -n $<
diff --git a/oscar64/InterCode.cpp b/oscar64/InterCode.cpp
index 08d04b5..818673e 100644
--- a/oscar64/InterCode.cpp
+++ b/oscar64/InterCode.cpp
@@ -1,4 +1,5 @@
 #include "InterCode.h"
+#include "Declaration.h"
 #include "CompilerTypes.h"
 
 #include <stdio.h>
@@ -27022,7 +27023,23 @@ void InterCodeBasicBlock::PeepholeOptimization(const GrowingVariableArray& stati
 // whatever the type said; an object known to be near (a global elsewhere, a local) needs
 // no translation even if its type is far (#pragma farspace's identity window: a near
 // object of a far type is at its own address); an address not known is far by its type.
-static int FarSpaceOfOperand(const InterOperand& op)
+// A local or parameter variable of the procedure that is a pointer: the alias pass gives a
+// pointer loaded from such a variable the variable's own base, so an access with that base
+// is through the pointer, to whatever it points at, not into the stack
+static bool IsPointerVariable(const InterCodeProcedure* proc, const InterOperand& op)
+{
+	const InterVariable* v = nullptr;
+	if (proc && op.mVarIndex >= 0)
+	{
+		if (op.mMemoryBase == IM_LOCAL && op.mVarIndex < proc->mLocalVars.Size())
+			v = proc->mLocalVars[op.mVarIndex];
+		else if (op.mMemoryBase == IM_PARAM && op.mVarIndex < proc->mParamVars.Size())
+			v = proc->mParamVars[op.mVarIndex];
+	}
+	return v && v->mDeclaration && v->mDeclaration->mBase && v->mDeclaration->mBase->mType == DT_TYPE_POINTER;
+}
+
+static int FarSpaceOfOperand(const InterOperand& op, const InterCodeProcedure* proc)
 {
 	if (op.mMemory == IM_GLOBAL)
 		return (op.mLinkerObject && op.mLinkerObject->mSection) ? op.mLinkerObject->mSection->mFarSpace : 0;
@@ -27030,8 +27047,11 @@ static int FarSpaceOfOperand(const InterOperand& op)
 	{
 		if (op.mMemoryBase == IM_GLOBAL && op.mLinkerObject && op.mLinkerObject->mSection)
 			return op.mLinkerObject->mSection->mFarSpace;
+		// an object on the stack (a near local or parameter of a far type) stays near; a
+		// pointer variable's target does not (mkroom.c's save_room(): r->nsubrooms through
+		// the parameter r was read untranslated, so the recursion followed garbage)
 		if (op.mMemoryBase == IM_LOCAL || op.mMemoryBase == IM_PARAM || op.mMemoryBase == IM_FPARAM || op.mMemoryBase == IM_FRAME || op.mMemoryBase == IM_FFRAME)
-			return 0;
+			return IsPointerVariable(proc, op) ? op.mFarSpace : 0;
 		return op.mFarSpace;
 	}
 	return 0;
@@ -27159,7 +27179,7 @@ static bool FarGroupUsedAhead(InterCodeBasicBlock* b, int space, int temp)
 			if ((k == 0 && (ins->mCode == IC_LOAD || ins->mCode == IC_COPY)) || (k == 1 && (ins->mCode == IC_STORE || ins->mCode == IC_FILL || ins->mCode == IC_COPY)))
 			{
 				const InterOperand& op = ins->mSrc[k];
-				if (op.mTemp == temp && IsFarGroupable(ins, op) && FarSpaceOfOperand(op) == space)
+				if (op.mTemp == temp && IsFarGroupable(ins, op) && FarSpaceOfOperand(op, b->mProc) == space)
 					return true;
 			}
 		}
@@ -27198,16 +27218,16 @@ bool InterCodeBasicBlock::LowerFarAccesses(const ExpandingArray<FarGroup>& inher
 		switch (ins->mCode)
 		{
 		case IC_LOAD:
-			s[0] = FarSpaceOfOperand(ins->mSrc[0]);
+			s[0] = FarSpaceOfOperand(ins->mSrc[0], mProc);
 			break;
 		case IC_STORE:
 		case IC_FILL:
-			s[1] = FarSpaceOfOperand(ins->mSrc[1]);
+			s[1] = FarSpaceOfOperand(ins->mSrc[1], mProc);
 			break;
 		case IC_COPY:
 		case IC_STRCPY:
-			s[0] = FarSpaceOfOperand(ins->mSrc[0]);
-			s[1] = FarSpaceOfOperand(ins->mSrc[1]);
+			s[0] = FarSpaceOfOperand(ins->mSrc[0], mProc);
+			s[1] = FarSpaceOfOperand(ins->mSrc[1], mProc);
 			break;
 		case IC_CALL:
 		case IC_CALL_NATIVE:
@@ -27345,7 +27365,7 @@ bool InterCodeBasicBlock::LowerFarAccesses(const ExpandingArray<FarGroup>& inher
 					xins->mSrc[0].mType = IT_POINTER;
 					xins->mSrc[0].mTemp = op.mTemp;
 					xins->mConst.mType = IT_INT32;
-					xins->mConst.mIntConst = FarSpaceOfOperand(op);
+					xins->mConst.mIntConst = FarSpaceOfOperand(op, mProc);
 					xins->mNumOperands = 1;
 					xins->mDst.mType = IT_POINTER;
 					xins->mDst.mTemp = mProc->AddTemporary(IT_POINTER);
@@ -27370,7 +27390,7 @@ bool InterCodeBasicBlock::LowerFarAccesses(const ExpandingArray<FarGroup>& inher
 					op.mRestricted = 0;
 				}
 				else
-					LowerFarOperand(mProc, out, ins, op, FarSpaceOfOperand(op));
+					LowerFarOperand(mProc, out, ins, op, FarSpaceOfOperand(op, mProc));
 			}
 
 			out.Push(ins);
-- 
