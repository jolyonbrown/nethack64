From ccd6406e42331a50649b66f44d22e2e984c17b2c Mon Sep 17 00:00:00 2001
From: Jolyon Brown <jolyon@limilo.com>
Date: Wed, 18 Nov 2026 03:45:00 +0000
Subject: [PATCH] Far spaces: a page translation in five bytes (farxzN), single
 accesses by page

An access alone within its far object now translates only the page, as a
group does (an object keeps to a page), and keeps the field's offset in
the access instead of translating the address plus offset.  When the
program defines farxzN, a page translation is LDX #reg (written by the
assembler, as for the 32-bit runtime calls) and JSR farxzN, which leaves
the RAM address in ADDR, where the optimizer can use it directly.
NCIF_ZP_16 marks such a zero page operand as two bytes, not four, so the
call does not keep the next two alive.  farspacetest also runs with
farxz1 (-dFARXZ).

Co-Authored-By: Claude <noreply@anthropic.com>
---
 autotest/farspacetest.c         | 16 ++++++++++
 autotest/makefile               |  5 +++
 oscar64/Compiler.cpp            |  3 ++
 oscar64/InterCode.cpp           | 25 ++++++++++++++-
 oscar64/NativeCodeGenerator.cpp | 54 +++++++++++++++++++++++++--------
 oscar64/NativeCodeGenerator.h   |  4 +++
 6 files changed, 93 insertions(+), 14 deletions(-)

diff --git a/autotest/farspacetest.c b/autotest/farspacetest.c
index a6236ee..43a81b4 100644
--- a/autotest/farspacetest.c
+++ b/autotest/farspacetest.c
@@ -37,6 +37,22 @@ __asm farxl1
 }
 #pragma runtime(farxl1, farxl1)
 
+#ifdef FARXZ
+/* the far pointer at the zero page address in X, translated into ADDR (page in A too),
+   Y kept: with it the compiler calls this for a page instead of farxl1 */
+__asm farxz1
+{
+		lda $00, x
+		sta __addr + 0
+		lda $01, x
+		tax
+		lda tlb1, x
+		sta __addr + 1
+		rts
+}
+#pragma runtime(farxz1, farxz1)
+#endif
+
 /* the address in A and X plus the offset in Y, translated: A and X */
 unsigned char xoff, xlo;
 
diff --git a/autotest/makefile b/autotest/makefile
index 73d3310..f6f9db6 100644
--- a/autotest/makefile
+++ b/autotest/makefile
@@ -57,6 +57,11 @@ farspacetest: farspacetest.c
 	$(OSCAR64_CC) -ea -g -O0 -n $<
 	$(OSCAR64_CC) -ea -g -Os -n $<
 	$(OSCAR64_CC) -ea -g -O3 -n $<
+	$(OSCAR64_CC) -ea -g -n -dFARXZ $<
+	$(OSCAR64_CC) -ea -g -O2 -n -dFARXZ $<
+	$(OSCAR64_CC) -ea -g -O0 -n -dFARXZ $<
+	$(OSCAR64_CC) -ea -g -Os -n -dFARXZ $<
+	$(OSCAR64_CC) -ea -g -O3 -n -dFARXZ $<
 
 stripedarraytest: stripedarraytest.c
 	$(OSCAR64_CC) -ea -g -n $<
diff --git a/oscar64/Compiler.cpp b/oscar64/Compiler.cpp
index 1642561..a0bee7e 100644
--- a/oscar64/Compiler.cpp
+++ b/oscar64/Compiler.cpp
@@ -1124,6 +1124,9 @@ bool Compiler::GenerateCode(void)
 			snprintf(rname, sizeof(rname), "farxo%d", i);
 			if (mCompilationUnits->mRuntimeScope->Lookup(Ident::Unique(rname)))
 				RegisterRuntime(loc, Ident::Unique(rname));
+			snprintf(rname, sizeof(rname), "farxz%d", i);
+			if (mCompilationUnits->mRuntimeScope->Lookup(Ident::Unique(rname)))
+				RegisterRuntime(loc, Ident::Unique(rname));
 		}
 		if (mCompilationUnits->mRuntimeScope->Lookup(Ident::Unique("farpins")))
 			RegisterRuntime(loc, Ident::Unique("farpins"));
diff --git a/oscar64/InterCode.cpp b/oscar64/InterCode.cpp
index 6b77ec2..7a03d80 100644
--- a/oscar64/InterCode.cpp
+++ b/oscar64/InterCode.cpp
@@ -27324,7 +27324,30 @@ bool InterCodeBasicBlock::LowerFarAccesses(const ExpandingArray<FarGroup>& inher
 				if (g[k] == -2)
 					continue;
 				InterOperand& op = ins->mSrc[k];
-				if (g[k] >= 0 && groups[g[k]].mSlot >= 0)
+				if (g[k] >= 0 && groups[g[k]].mSlot < 0)
+				{
+					// an access within its object alone: its page is the pointer's (an object
+					// keeps to a page), so only the page is translated, the offset staying in
+					// the access, which is shorter than translating the address plus offset
+					InterInstruction* xins = new InterInstruction(ins->mLocation, IC_UNARY_OPERATOR);
+					xins->mOperator = IA_FARXLAT;
+					xins->mSrc[0].mType = IT_POINTER;
+					xins->mSrc[0].mTemp = op.mTemp;
+					xins->mConst.mType = IT_INT32;
+					xins->mConst.mIntConst = FarSpaceOfOperand(op);
+					xins->mNumOperands = 1;
+					xins->mDst.mType = IT_POINTER;
+					xins->mDst.mTemp = mProc->AddTemporary(IT_POINTER);
+					out.Push(xins);
+					op.mTemp = xins->mDst.mTemp;
+					op.mMemoryBase = IM_NONE;
+					op.mLinkerObject = nullptr;
+					op.mVarIndex = -1;
+					op.mFarSpace = 0;
+					op.mFarObject = 0;
+					op.mRestricted = 0;
+				}
+				else if (g[k] >= 0)
 				{
 					// through the group's translation, at the field's offset
 					op.mTemp = groups[g[k]].mXTemp;
diff --git a/oscar64/NativeCodeGenerator.cpp b/oscar64/NativeCodeGenerator.cpp
index 2c894f7..2ca49a6 100644
--- a/oscar64/NativeCodeGenerator.cpp
+++ b/oscar64/NativeCodeGenerator.cpp
@@ -895,7 +895,7 @@ bool NativeCodeInstruction::IsUsedResultInstructions(NumberSet& requiredTemps)
 
 			if (mFlags & NCIF_USE_ZP_32_X)
