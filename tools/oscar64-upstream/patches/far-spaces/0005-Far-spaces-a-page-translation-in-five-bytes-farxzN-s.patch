 					}
@@ -41660,8 +41680,8 @@ bool NativeCodeBasicBlock::IsFinalZeroPageUseTail(const NativeCodeBasicBlock* bl
 			{
 				if (mIns[i].mFlags & NCIF_USE_ZP_32_X)
 				{
-					if (to >= mIns[i].mParam && to < mIns[i].mParam + 4 ||
-						from >= mIns[i].mParam && from < mIns[i].mParam + 4)
+					if (to >= mIns[i].mParam && to < mIns[i].mParam + mIns[i].ZpParamSize() ||
+						from >= mIns[i].mParam && from < mIns[i].mParam + mIns[i].ZpParamSize())
 						return false;
 				}
 			}
@@ -41775,8 +41795,8 @@ bool NativeCodeBasicBlock::IsFinalZeroPageUse(const NativeCodeBasicBlock* block,
 
 					if (mIns[at].mFlags & NCIF_USE_ZP_32_X)
 					{
-						if (to >= mIns[at].mParam && to < mIns[at].mParam + 4 ||
-							from >= mIns[at].mParam && from < mIns[at].mParam + 4)
+						if (to >= mIns[at].mParam && to < mIns[at].mParam + mIns[at].ZpParamSize() ||
+							from >= mIns[at].mParam && from < mIns[at].mParam + mIns[at].ZpParamSize())
 							return false;
 					}
 				}
@@ -72856,6 +72876,14 @@ LinkerObject* NativeCodeGenerator::AllocateShortMulTable(InterOperator op, int f
 	}
 }
 
+bool NativeCodeGenerator::HasRuntime(const Ident* ident) const
+{
+	for (int i = 0; i < mRuntime.Size(); i++)
+		if (mRuntime[i].mIdent == ident)
+			return mRuntime[i].mLinkerObject != nullptr;
+	return false;
+}
+
 NativeCodeGenerator::Runtime& NativeCodeGenerator::ResolveRuntime(const Ident* ident)
 {
 	int	i = 0;
diff --git a/oscar64/NativeCodeGenerator.h b/oscar64/NativeCodeGenerator.h
index e003f0d..71dc726 100644
--- a/oscar64/NativeCodeGenerator.h
+++ b/oscar64/NativeCodeGenerator.h
@@ -197,12 +197,15 @@ static const uint32 NICF_USE_WORKREGS = 0x04000000;
 
 static const uint32 NCIF_MEMMAP = 0x08000000;
 static const uint32 NCIF_SELFMOD = 0x10000000;
+// with NCIF_USE_ZP_32_X: the register is 16 bits (a far pointer, farxzN), not 32
+static const uint32 NCIF_ZP_16 = 0x20000000;
 
 static const uint32 NCIF_IMMADDR_FLAGS = NCIF_LOWER | NCIF_UPPER;
 
 class NativeCodeInstruction
 {
 public:
+	int ZpParamSize(void) const { return (mFlags & NCIF_ZP_16) ? 2 : 4; }
 	NativeCodeInstruction(void);
 	NativeCodeInstruction(const InterInstruction * ins, AsmInsType type, AsmInsMode mode = ASMIM_IMPLIED, int64 address = 0, LinkerObject * linkerObject = nullptr, uint32 flags = NCIF_LOWER | NCIF_UPPER, int param = 0, int minv = 0, int maxv = 255);
 	NativeCodeInstruction(const InterInstruction* ins, AsmInsType type, const NativeCodeInstruction & addr);
@@ -1202,6 +1205,7 @@ public:
 	void PopulateShortMulTables(void);
 
 	Runtime& ResolveRuntime(const Ident* ident);
+	bool HasRuntime(const Ident* ident) const;
 
 	Errors* mErrors;
 	Linker* mLinker;
