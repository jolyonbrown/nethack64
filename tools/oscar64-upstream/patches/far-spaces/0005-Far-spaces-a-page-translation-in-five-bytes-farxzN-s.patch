@@ -1897,7 +1897,7 @@ bool NativeCodeInstruction::LoadsZeroPage(int address) const
 
 			if (mFlags & NCIF_USE_ZP_32_X)
 			{
-				if (address >= mParam && address < mParam + 4)
+				if (address >= mParam && address < mParam + ZpParamSize())
 					return true;
 			}
 
@@ -5150,7 +5150,7 @@ void NativeCodeInstruction::FilterRegUsage(NumberSet& requiredTemps, NumberSet&
 			}
 			if (mFlags & NCIF_USE_ZP_32_X)
 			{
-				for (int i = 0; i < 4; i++)
+				for (int i = 0; i < ZpParamSize(); i++)
 				{
 					if (!providedTemps[mParam + i])
 						requiredTemps += mParam + i;
@@ -13568,9 +13568,11 @@ void NativeCodeBasicBlock::UnaryOperator(InterCodeProcedure* proc, NativeCodePro
 		int	sreg = BC_REG_TMP + proc->mTempOffset[ins->mSrc[0].mTemp];
 		int	space = int(ins->mConst.mIntConst & 0xff), offset = int((ins->mConst.mIntConst >> 8) & 0xff);
 		int	slot = int((ins->mConst.mIntConst >> 16) & 0xff);	// a group's pin slot + 1, 0 none
-		char	rname[16];
+		char	rname[16], zname[16];
 		snprintf(rname, sizeof(rname), offset ? "farxo%d" : "farxl%d", space);
-		NativeCodeGenerator::Runtime& frt(nproc->mGenerator->ResolveRuntime(Ident::Unique(rname)));
+		snprintf(zname, sizeof(zname), "farxz%d", space);
+		bool	zform = !offset && nproc->mGenerator->HasRuntime(Ident::Unique(zname));
+		NativeCodeGenerator::Runtime& frt(nproc->mGenerator->ResolveRuntime(Ident::Unique(zform ? zname : rname)));
 
 		if (offset)
 		{
@@ -13581,6 +13583,24 @@ void NativeCodeBasicBlock::UnaryOperator(InterCodeProcedure* proc, NativeCodePro
 			mIns.Push(NativeCodeInstruction(ins, ASMIT_STA, ASMIM_ZERO_PAGE, treg));
 			mIns.Push(NativeCodeInstruction(ins, ASMIT_STX, ASMIM_ZERO_PAGE, treg + 1));
 		}
+		else if (zform)
+		{
+			// farxzN takes the zero page address of the pointer in X (the assembler writes
+			// the LDX #, as for the other runtime calls with a zero page operand) and
+			// leaves the RAM address in ADDR, its page in A too, keeping Y: two bytes for
+			// the X, three for the JSR, and the access can often go through ADDR itself
+			NativeCodeGenerator::Runtime& zrt(nproc->mGenerator->ResolveRuntime(Ident::Unique(zname)));
+			mIns.Push(NativeCodeInstruction(ins, ASMIT_JSR, ASMIM_ABSOLUTE, zrt.mOffset, zrt.mLinkerObject, NCIF_RUNTIME | NCIF_LOWER | NCIF_UPPER | NCIF_USE_ZP_32_X | NCIF_ZP_16 | NCIF_PRESERVE_CPU_REG_Y, sreg));
+			if (slot)
+			{
+				NativeCodeGenerator::Runtime& prt(nproc->mGenerator->ResolveRuntime(Ident::Unique("farpins")));
+				mIns.Push(NativeCodeInstruction(ins, ASMIT_STA, ASMIM_ABSOLUTE, prt.mOffset + slot - 1, prt.mLinkerObject, NCIF_LOWER | NCIF_UPPER | NCIF_VOLATILE));
+			}
+			mIns.Push(NativeCodeInstruction(ins, ASMIT_LDA, ASMIM_ZERO_PAGE, BC_REG_ADDR));
+			mIns.Push(NativeCodeInstruction(ins, ASMIT_STA, ASMIM_ZERO_PAGE, treg));
+			mIns.Push(NativeCodeInstruction(ins, ASMIT_LDA, ASMIM_ZERO_PAGE, BC_REG_ADDR + 1));
+			mIns.Push(NativeCodeInstruction(ins, ASMIT_STA, ASMIM_ZERO_PAGE, treg + 1));
+		}
 		else
 		{
 			mIns.Push(NativeCodeInstruction(ins, ASMIT_LDX, ASMIM_ZERO_PAGE, sreg + 1));
@@ -17400,9 +17420,9 @@ void NativeCodeBasicBlock::CollectZeroPageUsage(NumberSet& used, NumberSet &modi
 
 						if (mIns[i].mFlags & NCIF_USE_ZP_32_X)
 						{
-							for (int j = 0; j < 4; j++)
+							for (int j = 0; j < mIns[i].ZpParamSize(); j++)
 								used += mIns[i].mParam + j;
-							for (int j = 0; j < 3; j++)
+							for (int j = 0; j < mIns[i].ZpParamSize() - 1; j++)
