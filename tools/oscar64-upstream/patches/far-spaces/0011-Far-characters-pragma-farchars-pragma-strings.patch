+		}
+
 		int g[2] = { -2, -2 };
 		for (int k = 0; k < 2; k++)
 		{
diff --git a/oscar64/InterCodeGenerator.cpp b/oscar64/InterCodeGenerator.cpp
index d41601a..54dc3ba 100644
--- a/oscar64/InterCodeGenerator.cpp
+++ b/oscar64/InterCodeGenerator.cpp
@@ -360,6 +360,10 @@ int InterCodeGenerator::BuiltinFarSpace(Expression* exp, const ExValue& v, int64
 	int space = v.mFarSpace;
 	if (!space && v.mReference == 0 && v.mType->mType == DT_TYPE_POINTER)
 		space = v.mType->mBase->FarSpace();
+	// an object of the character space keeps to a page (Linker::AddObject), so a block within
