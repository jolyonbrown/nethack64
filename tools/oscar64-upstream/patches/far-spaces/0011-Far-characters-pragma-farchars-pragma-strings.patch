+	if (space && space == FarCharSpace())
+		return space;
 	if (space)
 	{
 		Declaration* pt = (v.mType->mType == DT_TYPE_POINTER || v.mType->mType == DT_TYPE_ARRAY) ? v.mType->mBase : nullptr;
@@ -374,7 +378,9 @@ int InterCodeGenerator::BuiltinFarSpace(Expression* exp, const ExValue& v, int64
 // as a near pointer reads whatever RAM is at that address.
 void InterCodeGenerator::CheckFarConversion(Expression* exp, int from, int to)
 {
-	if (from && from != to)
+	// a byte pointer leaving the character space (to a struct, a void *) is still told by its
+	// address wherever a byte pointer reaches it again; a typed space's into it is not
+	if (from && from != to && from != FarCharSpace())
 		mErrors->Error(exp->mLocation, EWARN_FAR_POINTER_CONVERSION, "Pointer into a far space converted to a pointer outside it");
 }
 
diff --git a/oscar64/Linker.cpp b/oscar64/Linker.cpp
index f717b17..7002550 100644
--- a/oscar64/Linker.cpp
+++ b/oscar64/Linker.cpp
@@ -9,6 +9,18 @@ LinkerRegion::LinkerRegion(void)
 	  mSections(nullptr), mFreeChunks(FreeChunk{ 0, 0 } ), mLastObject(nullptr), mInlayObject(nullptr), mCartridgeBanks()
 {}
 
+static int gFarCharSpace = 0;
+
+void SetFarCharSpace(int space)
+{
+	gFarCharSpace = space;
+}
+
+int FarCharSpace(void)
+{
+	return gFarCharSpace;
+}
+
 LinkerSection::LinkerSection(void)
 	: mIdent(nullptr), mObjects(nullptr), mSections(nullptr), mStart(0), mEnd(0), mSize(0), mType(LST_NONE), mFlags(0), mFarSpace(0)
 {}
@@ -471,6 +483,10 @@ LinkerObject * Linker::AddObject(const Location& location, const Ident* ident, L
 	obj->mVariable = nullptr;
 	obj->mFlags = 0;
 	obj->mAlignment = alignment;
+	// a byte pointer's access translates the page the address is in, and a built-in copy or
+	// fill translates its start once, so an object of the character space keeps to a page
+	if (section && section->mFarSpace && section->mFarSpace == gFarCharSpace)
+		obj->mFlags |= LOBJF_NEVER_CROSS;
 	section->mObjects.Push(obj);
 	mObjects.Push(obj);
 	return obj;
diff --git a/oscar64/Linker.h b/oscar64/Linker.h
index da9b845..0f1402c 100644
--- a/oscar64/Linker.h
+++ b/oscar64/Linker.h
@@ -197,6 +197,11 @@ static const uint32 LSECF_PLACED = 0x00000002;
 // call stubs, not through stubs in the caller's own section (a bank too full for them)
 static const uint32 LSECF_RESIDENT_STUBS = 0x00000004;
 
+// #pragma farchars(n): far space n is the character space, which a byte through a pointer
+// reaches (Declaration::FarSpace), 0 if there is none
+void SetFarCharSpace(int space);
+int FarCharSpace(void);
+
 class LinkerSection
 {
 public:
diff --git a/oscar64/Parser.cpp b/oscar64/Parser.cpp
index 1600220..b38ab71 100644
--- a/oscar64/Parser.cpp
+++ b/oscar64/Parser.cpp
@@ -5,6 +5,18 @@
 #include "Constexpr.h"
 #include "NumberSet.h"
 
+// #pragma strings(codesection, stringsection): string literals written while codesection is
+// the code section go to stringsection (the character space's, say), others stay with their code
+static ExpandingArray<LinkerSection*>	StringsFrom, StringsTo;
+
+static LinkerSection* StringSection(LinkerSection* code)
+{
+	for (int i = 0; i < StringsFrom.Size(); i++)
+		if (StringsFrom[i] == code)
+			return StringsTo[i];
+	return code;
+}
+
 Parser::Parser(Errors* errors, Scanner* scanner, CompilationUnits* compilationUnits)
 	: mErrors(errors), mScanner(scanner), mCompilationUnits(compilationUnits), mParent(nullptr)
 {
@@ -7946,7 +7958,7 @@ Expression* Parser::ParseSimpleExpression(bool lhs, bool tid)
