diff --git a/oscar64/CompilerTypes.h b/oscar64/CompilerTypes.h
index b8b086a..383bf80 100644
--- a/oscar64/CompilerTypes.h
+++ b/oscar64/CompilerTypes.h
@@ -50,6 +50,9 @@ static const uint64 COPT_ERROR_FILES = 1ULL << 54;
 
 static const uint64 COPT_PROFILEINFO = 1ULL << 55;
 static const uint64 COPT_STRICT = 1ULL << 56;
+// #pragma farchars(off): this code's byte pointers are plain addresses, never the character
