+	$(OSCAR64_CC) -ea -g -O2 -n $<
+	$(OSCAR64_CC) -ea -g -O0 -n $<
+	$(OSCAR64_CC) -ea -g -Os -n $<
+	$(OSCAR64_CC) -ea -g -O3 -n $<
+	$(OSCAR64_CC) -ea -g -n -dFARXZ $<
+	$(OSCAR64_CC) -ea -g -O2 -n -dFARXZ $<
+	$(OSCAR64_CC) -ea -g -O0 -n -dFARXZ $<
+	$(OSCAR64_CC) -ea -g -Os -n -dFARXZ $<
+	$(OSCAR64_CC) -ea -g -O3 -n -dFARXZ $<
+	$(OSCAR64_CC) -ea -g -n -dFARXZ -dOSCAR_FARCHARS $<
+	$(OSCAR64_CC) -ea -g -O2 -n -dFARXZ -dOSCAR_FARCHARS $<
+	$(OSCAR64_CC) -ea -g -O0 -n -dFARXZ -dOSCAR_FARCHARS $<
+	$(OSCAR64_CC) -ea -g -Os -n -dFARXZ -dOSCAR_FARCHARS $<
+	$(OSCAR64_CC) -ea -g -O3 -n -dFARXZ -dOSCAR_FARCHARS $<
+
 # testn
 farspacetest: farspacetest.c
 	$(OSCAR64_CC) -ea -g -n $<
diff --git a/include/string.c b/include/string.c
index 389d252..4dae537 100644
--- a/include/string.c
+++ b/include/string.c
@@ -1,5 +1,13 @@
 #include "string.h"
 
+#ifdef OSCAR_FARCHARS
+// The character space (#pragma farchars): the assembler routines below translate each
+// pointer once, at entry, through the program's farxzc (the character space's translation
+// of the pointer at zero page address X into ADDR, an address below the space coming back
+// as it is). An object of the space keeps to a page, so a string or block in one does not
+// need more. The C routines translate byte by byte, as the compiler makes them.
+#endif
+
 #if 1
 
 char * strcpy(char * dst, const char * src)
@@ -10,6 +18,20 @@ char * strcpy(char * dst, const char * src)
 		sta accu
 		lda dst + 1
 		sta accu + 1
+#ifdef OSCAR_FARCHARS
+		ldx #dst
+		jsr farxzc
+		lda __addr
+		sta dst
+		lda __addr + 1
+		sta dst + 1
+		ldx #src
+		jsr farxzc
+		lda __addr
+		sta src
+		lda __addr + 1
+		sta src + 1
+#endif
 
 		ldy #0
 	L1:	lda (src), y
@@ -67,6 +89,20 @@ signed char strcmp(const char * ptr1, const char * ptr2)
 {
 	__asm 
 	{
+#ifdef OSCAR_FARCHARS
+		ldx #ptr1
+		jsr farxzc
+		lda __addr
+		sta ptr1
+		lda __addr + 1
+		sta ptr1 + 1
+		ldx #ptr2
+		jsr farxzc
+		lda __addr
+		sta ptr2
+		lda __addr + 1
+		sta ptr2 + 1
+#endif
 		ldy #0
 	L1: lda (ptr1), y
 		beq W1
@@ -267,6 +303,14 @@ void * memset(void * dst, int value, int size)
 {
 	__asm
 	{
+#ifdef OSCAR_FARCHARS
+		ldx #dst
+		jsr farxzc
+		lda __addr
+		sta dst
+		lda __addr + 1
+		sta dst + 1
+#endif
 			lda	value
 
 			ldx	size + 1
@@ -304,6 +348,20 @@ void * memcpy(void * dst, const void * src, int size)
 {
 	__asm
 	{
+#ifdef OSCAR_FARCHARS
+		ldx #dst
+		jsr farxzc
+		lda __addr
+		sta dst
+		lda __addr + 1
+		sta dst + 1
+		ldx #src
+		jsr farxzc
+		lda __addr
+		sta src
+		lda __addr + 1
+		sta src + 1
+#endif
 			ldx	size + 1
 			beq	_w1
 			ldy	#0
