+static const uint64 COPT_FAR_CHARS_OFF = 1ULL << 57;
 
 
 
diff --git a/oscar64/Declaration.cpp b/oscar64/Declaration.cpp
index e2db3be..e56b71a 100644
--- a/oscar64/Declaration.cpp
+++ b/oscar64/Declaration.cpp
@@ -1539,6 +1539,10 @@ int Declaration::FarSpace(void) const
 			if (FarSpaceTags[i] == dec->mIdent)
 				return FarSpaceIds[i];
 	}
+	// #pragma farchars: a byte reached through a pointer may be in the character space,
+	// which the translation tells by the address (a near pointer comes back as it is)
+	if (dec && dec->mType == DT_TYPE_INTEGER && dec->mSize == 1)
+		return FarCharSpace();
 	return 0;
 }
 
diff --git a/oscar64/InterCode.cpp b/oscar64/InterCode.cpp
index 1c0a8c4..08d04b5 100644
--- a/oscar64/InterCode.cpp
+++ b/oscar64/InterCode.cpp
@@ -21299,7 +21299,10 @@ bool InterCodeBasicBlock::MapLateIntrinsics(void)
 		{
 			InterInstruction* ins(mInstructions[i]);
 
+			// with a character space, a memcpy() through byte pointers stays a call (its
+			// arguments no longer say which space they are in)
 			if (ins->mCode == IC_CALL_NATIVE && ins->mSrc[0].mLinkerObject && 
