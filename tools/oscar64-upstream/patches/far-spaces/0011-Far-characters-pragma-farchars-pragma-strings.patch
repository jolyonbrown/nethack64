diff --git a/autotest/farcharstest.c b/autotest/farcharstest.c
new file mode 100644
index 0000000..9aa36da
--- /dev/null
+++ b/autotest/farcharstest.c
@@ -0,0 +1,233 @@
+/* Far characters (#pragma farchars, #pragma strings): far space 6 is the character space.
+ * A byte reached through a pointer is translated through farxl6/farxo6 (farxz6 with
+ * -dFARXZ), which leave an address below $C000 as it is and map $C100-$CFFF to a copy at
+ * $D100-$DFFF; main() fills $C100-$CFFF with garbage first, so a far byte that is not
+ * translated reads garbage.  The literals of the code section go to the character space's
+ * section, and its objects keep to a page.  Struct fields, locals, globals and volatile
+ * bytes are not translated, nor is code under #pragma farchars(off).  Native code only. */
+#include <string.h>
+
+#pragma farchars(6)
+
+#pragma section(farstr, 0)
+#pragma farsection(farstr, 6)
+#pragma region(farstr, 0xc100, 0xd000, , , { farstr })
+#pragma region(main, 0x0900, 0xc000, , , { code, data, bss, heap, stack })
+
+#pragma strings(code, farstr)
+
+/* the character space's page table: far page p at RAM page p + $10 from $C1 up */
+unsigned char tlb6[256];
+unsigned xlats;
+
+__asm farxl6
+{
+		inc xlats
+		bne n0
+		inc xlats + 1
+n0:		cpx #$c0
+		bcc near
+		lda tlb6, x
+		rts
+near:	txa
+		rts
+}
+#pragma runtime(farxl6, farxl6)
+
+#ifdef FARXZ
+__asm farxz6
+{
+		inc xlats
+		bne n1
+		inc xlats + 1
+n1:		lda $00, x
+		sta __addr + 0
+		lda $01, x
+		cmp #$c0
+		bcc near
+		tax
+		lda tlb6, x
+near:	sta __addr + 1
+		rts
+}
+#pragma runtime(farxz6, farxz6)
+
+#ifdef OSCAR_FARCHARS
+/* the library's assembler routines translate their pointers through farxzc (string.h) */
+void farxzc(void)
+{
+	__asm { jmp farxz6 }
+}
+#endif
+#endif
+
+unsigned char xoff, xlo;
+
+__asm farxo6
+{
+		inc xlats
+		bne n2
+		inc xlats + 1
+n2:		sty xoff
+		clc
+		adc xoff
+		bcc nc
+		inx
+nc:		cpx #$c0
+		bcc near
+		sta xlo
+		lda tlb6, x
+		tax
+		lda xlo
+near:	rts
+}
+#pragma runtime(farxo6, farxo6)
+
+unsigned char farpins[4];
+#pragma runtime(farpins, farpins)
+
+/* file scope: the code section's, so in the character space */
+const char * const names[] = { "alpha", "beta", "gamma", "delta-epsilon-zeta" };
+
+/* enough literals that one would cross a page if nothing kept them to one */
+const char * const many[] = {
+	"0123456789abcdefghi", "1123456789abcdefghi", "2123456789abcdefghi", "3123456789abcdefghi",
+	"4123456789abcdefghi", "5123456789abcdefghi", "6123456789abcdefghi", "7123456789abcdefghi",
+	"8123456789abcdefghi", "9123456789abcdefghi", "a123456789abcdefghi", "b123456789abcdefghi",
+	"c123456789abcdefghi", "d123456789abcdefghi", "e123456789abcdefghi", "f123456789abcdefghi",
+	"g123456789abcdefghi", "h123456789abcdefghi", "i123456789abcdefghi", "j123456789abcdefghi",
+};
+
+/* a writable buffer in the character space */
+#pragma bss(farstr)
+char fbuf[40];
+#pragma bss(bss)
+
+struct thing { char kind; char name[8]; int n; };
+struct thing things[2] = { { 'x', "near", 1 }, { 'y', "also", 2 } };
+
+char nearbuf[64];
+
+__noinline int mylen(const char * s)
+{
+	int n = 0;
+	while (s[n])
+		n++;
+	return n;
+}
+
+__noinline void mycpy(char * d, const char * s)
+{
+	while ((*d++ = *s++))
+		;
+}
+
+__noinline const char * pick(int i)
+{
+	return names[i];
+}
+
+__noinline char kind_of(struct thing * t)
+{
+	return t->kind;
+}
+
+__noinline const void * as_void(const char * s)
+{
+	return s;
+}
+
+__noinline int idx(int i) { return i; }
+
+#ifdef OSCAR_FARCHARS
+__noinline void lcpy(char * d, const char * s) { strcpy(d, s); }
+__noinline void lmcpy(char * d, const char * s, int n) { memcpy(d, s, n); }
+__noinline void lmset(char * d, char c, int n) { memset(d, c, n); }
+#endif
+
+#pragma farchars(off)
+
+/* plain addresses: what RAM holds */
+__noinline char raw(const char * p)
+{
+	return *p;
+}
+
+/* whether an object of n bytes at p crosses a page (the length comes from code that may
+ * read the space: code under farchars(off), inlined strlen() too, reads plain RAM) */
+__noinline int crosses(const char * p, int n)
+{
+	unsigned a = (unsigned)p;
+	return (a & 0xff) + n > 256;
+}
+
+__noinline void setup(void)
+{
+	for (int i = 0; i < 256; i++)
+		tlb6[i] = i;
+	for (int i = 0xc1; i < 0xd0; i++)
+		tlb6[i] = i + 0x10;
+	/* own loops: with -dOSCAR_FARCHARS the library's memcpy() and memset() translate what
+	 * they are given, plain addresses from code under farchars(off) too */
+	for (unsigned a = 0xc100; a < 0xd000; a++)
+	{
+		((char *)0x1000)[a] = *(char *)a;
+		*(char *)a = (char)0xee;
+	}
+}
+
+#pragma farchars(on)
+
+int main(void)
+{
+	setup();
+
+	int fails = 0;
+	const char * hello = "hello, world";
+	if ((unsigned)hello < 0xc100 || (unsigned)hello >= 0xd000) fails |= 1;	/* a literal is in the space */
+	if (mylen(hello) != 12 || hello[7] != 'w') fails |= 2;
+	if (names[1][2] != 't' || mylen(names[3]) != 18 || pick(2)[4] != 'a') fails |= 4;
+
+	char buf[32];
+	mycpy(buf, names[0]);
+	if (buf[0] != 'a' || buf[4] != 'a' || buf[5] != 0) fails |= 8;
+	strcpy(buf, names[3]);			/* the built-in strcpy, from the space to a local */
+	if (buf[17] != 'a' || buf[18] != 0) fails |= 16;
+	memcpy(buf, "xyz", 4);			/* the built-in memcpy */
+	if (buf[0] != 'x' || buf[3] != 0) fails |= 32;
+
+	mycpy(fbuf, "written far");		/* through a pointer into the space's buffer */
+	if (mylen(fbuf) != 11 || fbuf[8] != 'f' || raw(fbuf) != (char)0xee) fails |= 64;
+
+	mycpy(nearbuf, "near");			/* a near buffer through a pointer: left as it is */
+	if (nearbuf[3] != 'r' || raw(nearbuf) != 'n') fails |= 128;
+
+	unsigned before = xlats;
+	if (kind_of(&things[1]) != 'y' || things[0].name[1] != 'e') fails |= 256;	/* struct fields */
+	if (xlats != before) fails |= 512;
+
+	if (((const char *)as_void(names[2]))[1] != 'a') fails |= 1024;
+
+	int cross = 0;
+	for (int i = 0; i < 20; i++)
+		cross += crosses(many[i], mylen(many[i]) + 1);
+	for (int i = 0; i < 4; i++)
+		cross += crosses(names[i], mylen(names[i]) + 1);
+	if (cross || mylen(many[19]) != 19 || many[13][0] != 'd') fails |= 2048;
+
+#ifdef OSCAR_FARCHARS
+	/* the library's assembler strcpy, strcmp, memcpy and memset, called (not built in) */
+	lcpy(nearbuf, names[3]);
+	lcpy(fbuf, "library");
+	if (mylen(nearbuf) != 18 || strcmp(nearbuf, names[3]) || strcmp(fbuf, "library") || strcmp(names[0], "alpha")) fails |= 8192;
+	if (strcmp(names[1], names[2]) >= 0 || strcmp(names[2], "gamm") <= 0) fails |= 16384;
+	lmcpy(nearbuf, names[2], idx(6));
+	lmset(fbuf, 'z', idx(3));
+	if (nearbuf[4] != 'a' || fbuf[2] != 'z' || fbuf[3] != 'r' || raw(fbuf) != (char)0xee) fails |= 32768;
+#endif
+
+	/* a volatile byte is hardware's: not translated */
+	if (*(volatile char *)(char *)0xc100 != (char)0xee) fails |= 4096;
+
+	return fails;
+}
