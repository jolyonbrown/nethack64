+// The far space a built-in strcpy, memcpy or memset reaches through v (a pointer value or an
+// array's address), translated once for the whole block: only a far object of the pointer's
+// own type, or part of it, is sure to keep to a page (ADR-0009 point 5), so anything else
+// is reported
+int InterCodeGenerator::BuiltinFarSpace(Expression* exp, const ExValue& v, int64 size)
+{
+	int space = v.mFarSpace;
+	if (!space && v.mReference == 0 && v.mType->mType == DT_TYPE_POINTER)
+		space = v.mType->mBase->FarSpace();
+	if (space)
+	{
+		Declaration* pt = (v.mType->mType == DT_TYPE_POINTER || v.mType->mType == DT_TYPE_ARRAY) ? v.mType->mBase : nullptr;
+		if (!(pt && pt->FarSpace() == space && size <= pt->mSize && v.mType->mType == DT_TYPE_POINTER))
+			mErrors->Error(exp->mLocation, EWARN_FAR_POINTER_CONVERSION, "Far data copied or filled as a block that may span pages");
+	}
+	return space;
+}
+
+// A pointer that leaves its far space: a far pointer, or the address of far data, made a
+// pointer to a type outside the space.  It is still an address in the space, so using it
+// as a near pointer reads whatever RAM is at that address.
+void InterCodeGenerator::CheckFarConversion(Expression* exp, int from, int to)
+{
+	if (from && from != to)
+		mErrors->Error(exp->mLocation, EWARN_FAR_POINTER_CONVERSION, "Pointer into a far space converted to a pointer outside it");
+}
