diff --git a/autotest/farspacetest.c b/autotest/farspacetest.c
new file mode 100644
index 0000000..6fcbf56
--- /dev/null
+++ b/autotest/farspacetest.c
@@ -0,0 +1,120 @@
+/* Far spaces (#pragma farspace, #pragma farsection): struct types whose pointers are
+ * addresses in a far space, and a section whose objects are there, translated through the
+ * program's farxl1 (a page) or farxo1 (an address plus an offset) at each access.  The far section is linked at $8000; the translation
+ * maps its pages to a copy at $9000, and main() fills $8000 with garbage first, so an
+ * access that is not translated reads garbage.  Native code only. */
+#include <string.h>
+
+#pragma farspace(1, rec, sub, ext)
+
+#pragma section(fardata, 0)
+#pragma farsection(fardata, 1)
+#pragma region(farr, 0x8000, 0x9000, , , { fardata })
+#pragma region(main, 0x0900, 0x8000, , , { code, data, bss, heap, stack })
+
+struct sub { char a; int b; };
+struct rec { char c; int v; struct sub s[2]; struct rec * next; long l; char x[4]; };
+
+/* an extension laid over a member, as NetHack's EPRI(mon) over mon->mextra */
+struct ext { int e1, e2; };
+#define EXT(r)	((struct ext *) &(r)->x[0])
+
+#pragma data(fardata)
+struct rec table[8] = {
+	{ 'a', 100, { { 1, 11 }, { 2, 22 } }, &table[1], 1000L },
+	{ 'b', 200, { { 3, 33 }, { 4, 44 } }, &table[2], 2000L },
+	{ 'c', 300, { { 5, 55 }, { 6, 66 } }, nullptr, 3000L },
+};
+#pragma data(data)
+
+/* the space's page table: far page p at RAM page p + $10 */
+unsigned char tlb1[256];
+
+__asm farxl1
+{
+		lda tlb1, x
+		rts
+}
+#pragma runtime(farxl1, farxl1)
+
+/* the address in A and X plus the offset in Y, translated: A and X */
+unsigned char xoff, xlo;
+
+__asm farxo1
+{
+		sty xoff
+		clc
+		adc xoff
+		bcc nc
+		inx
+nc:		sta xlo
+		lda tlb1, x
+		tax
+		lda xlo
+		rts
+}
+#pragma runtime(farxo1, farxo1)
+
+struct rec nearrec = { 'n', 7, { { 8, 9 }, { 10, 11 } }, nullptr, 12L };
+
+__noinline int sumlist(struct rec * r)
+{
+	int s = 0;
+	while (r)
+	{
+		s += r->v + r->s[0].b + r->s[1].a;
+		r = r->next;
+	}
+	return s;
+}
+
+__noinline int idx(int i) { return i; }
+
+__noinline void bump(struct rec * r, int d)
+{
+	r->v += d;
+	r->s[1].b++;
+	r->l += d;
+}
+
+__noinline struct sub * second(struct rec * r) { return &r->s[1]; }
+
+int main(void)
+{
+	for (int i = 0; i < 256; i++)
+		tlb1[i] = i;
+	for (int i = 0x80; i < 0x90; i++)
+		tlb1[i] = i + 0x10;
+	memcpy((char *)0x9000, (char *)0x8000, 0x1000);
+	memset((char *)0x8000, 0xee, 0x1000);
+
+	int fails = 0;
+	if (sumlist(table) != 100 + 11 + 2 + 200 + 33 + 4 + 300 + 55 + 6) fails |= 1;
+	if (table[idx(1)].c != 'b') fails |= 2;
+	if (table[2].s[1].b != 66) fails |= 4;
+	bump(&table[1], 5);
+	if (table[1].v != 205 || table[1].s[1].b != 45 || table[1].l != 2005L) fails |= 8;
+	if (second(&table[0])->b != 22) fails |= 16;
+	table[3] = table[2];				/* far to far copy */
+	if (table[3].v != 300 || table[3].s[0].b != 55 || table[3].l != 3000L) fails |= 32;
+	nearrec = table[0];					/* far to near */
+	if (nearrec.v != 100 || nearrec.s[1].b != 22) fails |= 64;
+	table[4] = nearrec;					/* near to far */
+	if (table[4].c != 'a' || table[4].l != 1000L) fails |= 128;
+	if (sumlist(&nearrec) != 100 + 11 + 2 + sumlist(&table[1])) fails |= 256;	/* a near object of a far type */
+	struct rec * p = &table[0];
+	p++;
+	if (p->c != 'b' || p[1].c != 'c') fails |= 512;
+	EXT(&table[5])->e2 = 77;
+	EXT(&table[5])->e1 = EXT(&table[5])->e2 + 1;
+	struct ext * e = EXT(p);
+	e->e1 = 5;
+	if (EXT(&table[5])->e1 != 78 || table[5].x[2] != 77 || EXT(&table[1])->e1 != 5) fails |= 2048;
+	/* the built-in memset and memcpy of a whole far object */
+	memset(&table[6], 0, sizeof(struct rec));
+	memcpy(&table[7], &table[2], sizeof(struct rec));
+	if (table[6].v != 0 || table[6].l != 0 || table[7].v != 300 || table[7].s[1].b != 66) fails |= 4096;
+	/* the far copy still holds what was stored, the fake addresses only garbage */
+	if (*(char *)0x8000 != (char)0xee || *(char *)0x9000 != 'a') fails |= 1024;
+	return fails;
+}
