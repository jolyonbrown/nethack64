From 757a917f4513b6a172a5506783c55dea62bbfa2e Mon Sep 17 00:00:00 2001
From: Jolyon Brown <jolyon@limilo.com>
Date: Sat, 21 Nov 2026 23:38:37 +0000
Subject: [PATCH] Two loads through one pointer: not swapped when the second
 loads the pointer

PeepholeReplaceOptimization() sorts two loads through the same pointer by offset,
and checked that the first does not overwrite the pointer but not that the second
does. In `for (; o; o = o->nobj) s += o->oclass;` it swapped the field's load
(offset 4) with `o = o->nobj` (offset 0), so the field came from the next object:
the first object skipped, the last read through null. -O1 and up, native code;
v1.32.273, the pin and upstream main 08b01c9 (2026-11-21). Every NetHack list
walk that reads a field before stepping along the link has this shape.

The swap now also needs the second load's destination to be neither the pointer
nor the first load's destination.

autotest/loadordertest.c: the sum of a field over a list, a mix of an int and a
char array element, and a count by a field: -n at -O0 to -O3 and -bc, 7 of 7;
the pin fails it (3).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 autotest/loadordertest.c | 46 ++++++++++++++++++++++++++++++++++++++++
 autotest/makefile        | 10 +++++++++
 oscar64/InterCode.cpp    |  5 +++++
 3 files changed, 61 insertions(+)
 create mode 100644 autotest/loadordertest.c

diff --git a/autotest/loadordertest.c b/autotest/loadordertest.c
new file mode 100644
index 0000000..221bb50
--- /dev/null
+++ b/autotest/loadordertest.c
@@ -0,0 +1,46 @@
+// Two loads through one pointer are sorted by offset (PeepholeReplaceOptimization), but not
+// when the second one loads a new value of the pointer: a field read before `o = o->nobj`
+// must come from the object it was read from.
+struct obj { struct obj * nobj; int v; char oclass; char name[9]; };
+
+struct obj objs[4] = {
+	{ &objs[1], 1, 10, "abcdefgh" }, { &objs[2], 2, 20, "ijklmnop" },
+	{ &objs[3], 3, 30, "qrstuvwx" }, { nullptr, 4, 40, "yzABCDEF" } };
+
+__noinline int classes(struct obj * o)
+{
+	int s = 0;
+	for (; o; o = o->nobj)
+		s += o->oclass;
+	return s;
+}
+
+__noinline long mixed(struct obj * o)
+{
+	long s = 0;
+	while (o)
+	{
+		s += o->v + o->name[2];
+		o = o->nobj;
+	}
+	return s;
+}
+
+__noinline int count(struct obj * o, char c)
+{
+	int n = 0;
+	for (; o; o = o->nobj)
+		if (o->oclass == c)
+			n++;
+	return n;
+}
+
+int main(void)
+{
+	struct obj * volatile hp = objs;
+	int fails = 0;
+	if (classes(hp) != 100) fails |= 1;
+	if (mixed(hp) != 10 + 'c' + 'k' + 's' + 'A') fails |= 2;
+	if (count(hp, 10) != 1 || count(hp, 40) != 1) fails |= 4;
+	return fails;
+}
diff --git a/autotest/makefile b/autotest/makefile
index a8ad486..519c7df 100644
--- a/autotest/makefile
+++ b/autotest/makefile
@@ -58,6 +58,16 @@ fardefaulttest: fardefaulttest.c
 	$(OSCAR64_CC) -ea -g -Os -n $<
 	$(OSCAR64_CC) -ea -g -O3 -n $<
 
+# testn
+loadordertest: loadordertest.c
+	$(OSCAR64_CC) -ea -g -n $<
+	$(OSCAR64_CC) -ea -g -O2 -n $<
+	$(OSCAR64_CC) -ea -g -O0 -n $<
+	$(OSCAR64_CC) -ea -g -Os -n $<
+	$(OSCAR64_CC) -ea -g -O3 -n $<
+	$(OSCAR64_CC) -ea -g -bc $<
+	$(OSCAR64_CC) -ea -g -Os -bc $<
+
 # testn
 farcharstest: farcharstest.c
 	$(OSCAR64_CC) -ea -g -n $<
diff --git a/oscar64/InterCode.cpp b/oscar64/InterCode.cpp
index 4007b50..9c7cbc3 100644
--- a/oscar64/InterCode.cpp
+++ b/oscar64/InterCode.cpp
@@ -24531,11 +24531,16 @@ bool InterCodeBasicBlock::PeepholeReplaceOptimization(const GrowingVariableArray
 			{
 				// just skip it
 			}
+			// two loads through one pointer, sorted by offset; not when the second one loads a new
+			// value of the pointer (p->field then p = p->next: the field would come from the
+			// next object), nor into the same temporary
 			else if (mInstructions[i + 0]->mCode == IC_LOAD &&
 				mInstructions[i + 1]->mCode == IC_LOAD &&
 				mInstructions[i + 1]->mSrc[0].mTemp == mInstructions[i + 0]->mSrc[0].mTemp &&
 				mInstructions[i + 0]->mSrc[0].mIntConst > mInstructions[i + 1]->mSrc[0].mIntConst &&
 				mInstructions[i + 1]->mSrc[0].mTemp != mInstructions[i + 0]->mDst.mTemp &&
+				mInstructions[i + 1]->mDst.mTemp != mInstructions[i + 0]->mSrc[0].mTemp &&
+				mInstructions[i + 1]->mDst.mTemp != mInstructions[i + 0]->mDst.mTemp &&
 				!(mInstructions[i + 0]->mVolatile && mInstructions[i + 1]->mVolatile))
 			{
 				SwapInstructions(mInstructions[i + 0], mInstructions[i + 1]);
-- 
