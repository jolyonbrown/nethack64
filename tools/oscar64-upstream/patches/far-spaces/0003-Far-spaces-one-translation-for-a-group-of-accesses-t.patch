+// Accesses in a block through one pointer to a far struct object, within the object, share
+// one translation of the pointer's page (an object keeps to a page, ADR-0009 point 5): a
+// group.  Its translation stores its RAM page in one of the runtime's pin slots (farpins),
+// whose pages the fault handler does not evict, so other translations may come between the
+// group's accesses; a call ends every group (the callee uses the slots too), and so does a
+// new value of the pointer.  Groups that overlap take different slots; with none free, the
+// accesses are translated one by one.
+static const int FAR_PIN_SLOTS = 4;
+
+struct FarGroup
+{
+	int		mSpace, mTemp, mFirst, mLast, mCount, mSlot, mXTemp;
+	bool	mOpen;
+};
+
+static bool IsFarGroupable(const InterInstruction* ins, const InterOperand& op)
+{
+	return ins->mCode != IC_STRCPY && op.mMemory == IM_INDIRECT && op.mTemp >= 0 && op.mFarObject > 0 &&
+		op.mIntConst >= 0 && op.mIntConst + (op.mOperandSize > 0 ? op.mOperandSize : 1) <= op.mFarObject;
+}
+
 bool InterCodeBasicBlock::LowerFarAccesses(void)
 {
 	bool	changed = false;
@@ -27133,37 +27154,152 @@ bool InterCodeBasicBlock::LowerFarAccesses(void)
 	{
 		mVisited = true;
 
-		for (int i = 0; i < mInstructions.Size(); i++)
+		int n = mInstructions.Size();
+		// for each instruction and operand: the group it belongs to, -1 alone, -2 near
+		ExpandingArray<int>	gof0, gof1;
+		ExpandingArray<FarGroup>	groups;
+		bool any = false;
+
+		for (int i = 0; i < n; i++)
 		{
 			InterInstruction* ins = mInstructions[i];
-			int s0 = 0, s1 = 0;
+			int s[2] = { 0, 0 };
 
 			switch (ins->mCode)
 			{
 			case IC_LOAD:
-				s0 = FarSpaceOfOperand(ins->mSrc[0]);
+				s[0] = FarSpaceOfOperand(ins->mSrc[0]);
 				break;
 			case IC_STORE:
 			case IC_FILL:
-				s1 = FarSpaceOfOperand(ins->mSrc[1]);
+				s[1] = FarSpaceOfOperand(ins->mSrc[1]);
 				break;
 			case IC_COPY:
 			case IC_STRCPY:
-				s0 = FarSpaceOfOperand(ins->mSrc[0]);
-				s1 = FarSpaceOfOperand(ins->mSrc[1]);
+				s[0] = FarSpaceOfOperand(ins->mSrc[0]);
+				s[1] = FarSpaceOfOperand(ins->mSrc[1]);
+				break;
+			case IC_CALL:
+			case IC_CALL_NATIVE:
+			case IC_ASSEMBLER:
+			case IC_DISPATCH:
+				for (int j = 0; j < groups.Size(); j++)
+					groups[j].mOpen = false;
 				break;
 			}
 
-			if (s0 || s1)
+			int g[2] = { -2, -2 };
+			for (int k = 0; k < 2; k++)
 			{
+				if (!s[k])
+					continue;
+				any = true;
 				if (ins->mVolatile)
 					mProc->mModule->mErrors->Error(ins->mLocation, EERR_INCOMPATIBLE_TYPES, "Volatile access to far data");
-				if (s0)
-					LowerFarOperand(mProc, mInstructions, i, ins->mSrc[0], s0);
-				if (s1)
-					LowerFarOperand(mProc, mInstructions, i, ins->mSrc[1], s1);
-				changed = true;
+				const InterOperand& op = ins->mSrc[k];
+				g[k] = -1;
+				if (IsFarGroupable(ins, op))
+				{
+					int j = 0;
+					while (j < groups.Size() && !(groups[j].mOpen && groups[j].mSpace == s[k] && groups[j].mTemp == op.mTemp))
+						j++;
+					if (j == groups.Size())
+					{
+						FarGroup	fg;
+						fg.mSpace = s[k]; fg.mTemp = op.mTemp; fg.mFirst = i; fg.mLast = i; fg.mCount = 0; fg.mSlot = -1; fg.mXTemp = -1;
+						fg.mOpen = true;
+						groups.Push(fg);
+					}
+					groups[j].mLast = i;
+					groups[j].mCount++;
+					g[k] = j;
+				}
 			}
+			gof0.Push(g[0]);
+			gof1.Push(g[1]);
+
+			// a new value of a pointer ends its groups
+			if (ins->mDst.mTemp >= 0)
+			{
+				for (int j = 0; j < groups.Size(); j++)
+					if (groups[j].mOpen && groups[j].mTemp == ins->mDst.mTemp)
+						groups[j].mOpen = false;
+			}
+		}
+
+		if (any)
+		{
+			// slots for the groups of two or more, by the order they start in
+			int slotEnd[FAR_PIN_SLOTS];
+			for (int k = 0; k < FAR_PIN_SLOTS; k++)
+				slotEnd[k] = -1;
+			for (int j = 0; j < groups.Size(); j++)
+			{
+				if (groups[j].mCount < 2)
+					continue;
+				for (int k = 0; k < FAR_PIN_SLOTS; k++)
+				{
+					if (slotEnd[k] < groups[j].mFirst)
+					{
+						groups[j].mSlot = k;
+						slotEnd[k] = groups[j].mLast;
+						break;
+					}
+				}
+			}
+
+			GrowingInstructionArray	out(nullptr);
+			for (int i = 0; i < n; i++)
+			{
+				InterInstruction* ins = mInstructions[i];
+
+				for (int j = 0; j < groups.Size(); j++)
+				{
+					FarGroup& fg(groups[j]);
+					if (fg.mSlot >= 0 && fg.mFirst == i)
+					{
+						InterInstruction* xins = new InterInstruction(ins->mLocation, IC_UNARY_OPERATOR);
+						xins->mOperator = IA_FARXLAT;
+						xins->mSrc[0].mType = IT_POINTER;
+						xins->mSrc[0].mTemp = fg.mTemp;
+						xins->mConst.mType = IT_INT32;
+						xins->mConst.mIntConst = fg.mSpace + ((int64)(fg.mSlot + 1) << 16);
+						xins->mNumOperands = 1;
+						xins->mDst.mType = IT_POINTER;
+						xins->mDst.mTemp = mProc->AddTemporary(IT_POINTER);
+						out.Push(xins);
+						fg.mXTemp = xins->mDst.mTemp;
+					}
+				}
+
+				int g[2] = { gof0[i], gof1[i] };
+				for (int k = 0; k < 2; k++)
+				{
+					if (g[k] == -2)
+						continue;
+					InterOperand& op = ins->mSrc[k];
+					if (g[k] >= 0 && groups[g[k]].mSlot >= 0)
+					{
+						// through the group's translation, at the field's offset
+						op.mTemp = groups[g[k]].mXTemp;
+						op.mMemoryBase = IM_NONE;
+						op.mLinkerObject = nullptr;
+						op.mVarIndex = -1;
+						op.mFarSpace = 0;
+						op.mFarObject = 0;
+						op.mRestricted = 0;
+					}
+					else
+						LowerFarOperand(mProc, out, ins, op, FarSpaceOfOperand(op));
+				}
+
+				out.Push(ins);
+			}
+
+			mInstructions.SetSize(0);
+			for (int i = 0; i < out.Size(); i++)
+				mInstructions.Push(out[i]);
+			changed = true;
 		}
 
 		if (mTrueJump && mTrueJump->LowerFarAccesses()) changed = true;
