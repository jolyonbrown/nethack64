+// The size of an object of a far struct type, which keeps to a page (ADR-0009 point 5) and
+// so can be translated once for all its fields; 0 if the type is not such a struct
+int InterCodeGenerator::FarObjectSize(Declaration* type)
+{
+	if (type && (type->mType == DT_TYPE_STRUCT || type->mType == DT_TYPE_UNION) && type->FarSpace() && type->mSize > 0 && type->mSize <= 256)
+		return type->mSize;
+	return 0;
