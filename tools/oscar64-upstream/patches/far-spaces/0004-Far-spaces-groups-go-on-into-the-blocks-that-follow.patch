+// Far accesses (#pragma farspace), block by block in depth-first order, so that a block
+// entered from one block only comes after it and takes over the groups it leaves open
+bool InterCodeProcedure::LowerFarAccesses(void)
+{
+	ExpandingArray<InterCodeBasicBlock*>	order, stack;
+	ResetVisited();
+	stack.Push(mEntryBlock);
+	while (stack.Size())
+	{
+		InterCodeBasicBlock* b = stack.Pop();
+		if (b->mVisited)
+			continue;
+		b->mVisited = true;
+		order.Push(b);
+		if (b->mFalseJump && !b->mFalseJump->mVisited)
+			stack.Push(b->mFalseJump);
+		if (b->mTrueJump && !b->mTrueJump->mVisited)
+			stack.Push(b->mTrueJump);
+	}
+
+	// the blocks that lead into each block, by their place in the order; -1 for the entry
+	ExpandingArray<ExpandingArray<int>*>	preds;
+	for (int i = 0; i < order.Size(); i++)
+		preds.Push(new ExpandingArray<int>());
+	if (order.Size())
+		preds[0]->Push(-1);
+	for (int i = 0; i < order.Size(); i++)
+	{
+		InterCodeBasicBlock* succ[2] = { order[i]->mTrueJump, order[i]->mFalseJump };
+		for (int k = 0; k < 2; k++)
+		{
+			if (!succ[k] || (k == 1 && succ[1] == succ[0]))
+				continue;
+			int j = 0;
+			while (j < order.Size() && order[j] != succ[k])
+				j++;
+			if (j < order.Size())
+				preds[j]->Push(i);
+		}
+	}
+
+	ExpandingArray<ExpandingArray<FarGroup>*>	passed;
+	for (int i = 0; i < order.Size(); i++)
+		passed.Push(new ExpandingArray<FarGroup>());
+
+	bool changed = false;
+	for (int i = 0; i < order.Size(); i++)
+	{
+		// a group every block leading here passes on (the same translation in its slot,
+		// from a block that dominates this one, nothing between): only when all of them come
+		// before this block, so not over a loop's way back
+		ExpandingArray<FarGroup>	inherited;
+		const ExpandingArray<int>& pi(*preds[i]);
+		bool all = pi.Size() > 0;
+		for (int k = 0; k < pi.Size(); k++)
+			if (pi[k] < 0 || pi[k] >= i)
+				all = false;
+		if (all)
+		{
+			const ExpandingArray<FarGroup>& first(*passed[pi[0]]);
+			for (int g = 0; g < first.Size(); g++)
+			{
+				bool everywhere = true;
+				for (int k = 1; k < pi.Size() && everywhere; k++)
+				{
+					const ExpandingArray<FarGroup>& other(*passed[pi[k]]);
+					int h = 0;
+					while (h < other.Size() && !(other[h].mXTemp == first[g].mXTemp && other[h].mSlot == first[g].mSlot && other[h].mTemp == first[g].mTemp))
+						h++;
+					if (h == other.Size())
+						everywhere = false;
+				}
+				if (everywhere)
+					inherited.Push(first[g]);
+			}
+		}
+		// the blocks after this one it leads to, which may take its groups over
+		InterCodeBasicBlock* next[2] = { nullptr, nullptr };
+		InterCodeBasicBlock* succ[2] = { order[i]->mTrueJump, order[i]->mFalseJump };
+		for (int k = 0; k < 2; k++)
+		{
+			if (!succ[k] || (k == 1 && succ[1] == succ[0]))
+				continue;
+			int j = 0;
+			while (j < order.Size() && order[j] != succ[k])
+				j++;
+			if (j < order.Size() && j > i)
+				next[k] = succ[k];
+		}
+		if (order[i]->LowerFarAccesses(inherited, *passed[i], next[0], next[1]))
+			changed = true;
+	}
+
+	for (int i = 0; i < passed.Size(); i++)
+		delete passed[i];
+	for (int i = 0; i < preds.Size(); i++)
+		delete preds[i];
+
+	return changed;
+}
