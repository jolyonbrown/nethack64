+		InterInstruction* ins = b->mInstructions[i];
+		if (ins->mCode == IC_CALL || ins->mCode == IC_CALL_NATIVE || ins->mCode == IC_ASSEMBLER || ins->mCode == IC_DISPATCH)
+			return false;
+		for (int k = 0; k < 2; k++)
+		{
+			if ((k == 0 && (ins->mCode == IC_LOAD || ins->mCode == IC_COPY)) || (k == 1 && (ins->mCode == IC_STORE || ins->mCode == IC_FILL || ins->mCode == IC_COPY)))
