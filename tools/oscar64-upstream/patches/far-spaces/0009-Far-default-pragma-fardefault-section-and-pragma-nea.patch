 	: mErrors(errors), mSections(nullptr), mReferences(nullptr), mObjects(nullptr), mRegions(nullptr), mOverlays(nullptr), mBreakpoints(0), mCompilerOptions(COPT_DEFAULT),
-	  mProgramStart(0), mProgramEnd(0)
+	  mProgramStart(0), mProgramEnd(0), mFarDefault(nullptr)
 {
 	for (int i = 0; i < CartridgeBankSet::NUM_BANKS; i++)
 	{
@@ -560,6 +560,19 @@ void Linker::CheckDirectJumps(void)
 // The cartridge bank of the code in a section: the bank of the one region that holds
 // it, or -1 when it is not in exactly one region of exactly one bank (resident code,
 // or a section placed in several banks).
+// The section of a variable declared under #pragma fardefault: the far default section in
+// place of the default data or bss section, unless #pragma near names it
+LinkerSection* Linker::FarDefaultSection(const Ident* ident, LinkerSection* section, bool fardefault)
+{
+	if (!fardefault || !mFarDefault || !section || !section->mIdent ||
+		(strcmp(section->mIdent->mString, "data") && strcmp(section->mIdent->mString, "bss")))
+		return section;
+	for (int i = 0; i < mNearIdents.Size(); i++)
+		if (mNearIdents[i] == ident)
+			return section;
+	return mFarDefault;
+}
+
 int Linker::SectionBank(LinkerSection* section)
 {
 	LinkerRegion* rgn = FindRegionOfSection(section);
