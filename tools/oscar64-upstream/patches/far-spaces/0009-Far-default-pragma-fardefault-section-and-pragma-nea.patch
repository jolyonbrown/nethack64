diff --git a/autotest/fardefaulttest.c b/autotest/fardefaulttest.c
new file mode 100644
index 0000000..4b40ac4
--- /dev/null
+++ b/autotest/fardefaulttest.c
@@ -0,0 +1,93 @@
+/* #pragma fardefault(section) and #pragma near(name, ...): variables declared under
+ * fardefault whose section would be the default data or bss go to the far section, unless
+ * near names them.  The far section is linked at $8000; the translation maps its pages to a
+ * copy at $9000, and main() fills $8000 with garbage first, so a far variable read or
+ * written without a translation reads garbage (as in farspacetest.c).  Native code only. */
+#include <string.h>
+
+#pragma section(fardata, 0)
+#pragma farsection(fardata, 1)
+#pragma region(farr, 0x8000, 0x9000, , , { fardata })
+#pragma region(main, 0x0900, 0x8000, , , { code, data, bss, heap, stack })
+
+/* the space's page table: far page p at RAM page p + $10 */
+unsigned char tlb1[256];
+
+__asm farxl1
+{
+		lda tlb1, x
+		rts
+}
+#pragma runtime(farxl1, farxl1)
+
+unsigned char xoff, xlo;
+
+__asm farxo1
+{
+		sty xoff
+		clc
+		adc xoff
+		bcc nc
+		inx
+nc:		sta xlo
+		lda tlb1, x
+		tax
+		lda xlo
+		rts
+}
+#pragma runtime(farxo1, farxo1)
+
+unsigned char farpins[4];
+#pragma runtime(farpins, farpins)
+
+int before = 3;			/* before the pragma: near */
+extern int early;		/* declared before, defined under it: far */
+
+#pragma near(keep, hits)
+#pragma fardefault(fardata)
+
+int early = 5;
+int counter;			/* bss */
+int table[40] = { 1, 2, 3 };
+struct pt { char x; int y; } pts[3] = { { 1, 10 }, { 2, 20 }, { 3, 30 } };
+char text[16] = "far text";
+int keep = 9;			/* named near */
+int hits;
+
+__noinline int tick(void)
+{
+	static int calls = 100;	/* a function's static: far too */
+	return ++calls;
+}
+
+#pragma fardefault()
+
+int after = 4;			/* after fardefault(): near */
+
+__noinline int idx(int i) { return i; }
+
+int main(void)
+{
+	for (int i = 0; i < 256; i++)
+		tlb1[i] = i;
+	for (int i = 0x80; i < 0x90; i++)
+		tlb1[i] = i + 0x10;
+	memcpy((char *)0x9000, (char *)0x8000, 0x1000);
+	memset((char *)0x8000, 0xee, 0x1000);
+
+	int fails = 0;
+	if (early != 5 || table[idx(2)] != 3 || pts[idx(1)].y != 20 || text[idx(4)] != 't') fails |= 1;
+	counter += 7;
+	table[idx(30)] = counter;
+	pts[idx(2)].x = 'z';
+	if (counter != 7 || table[30] != 7 || pts[2].x != 'z' || pts[2].y != 30) fails |= 2;
+	if (tick() != 101 || tick() != 102) fails |= 4;
+	/* the near ones are where near data is, and hold their values */
+	if ((unsigned)&before >= 0x8000 || (unsigned)&after >= 0x8000 ||
+		(unsigned)&keep >= 0x8000 || (unsigned)&hits >= 0x8000) fails |= 8;
+	hits = keep + before + after;
+	if (hits != 16) fails |= 16;
+	/* the far copy holds what was stored, the fake addresses only garbage */
+	if (*(unsigned char *)0x8000 != 0xee) fails |= 32;
+	return fails;
+}
