 					var->mLinkerObject->mVariable = var;
 
 					if (dec->mBase->mFlags & DTF_CONST)
@@ -2569,7 +2569,7 @@ InterCodeGenerator::ExValue InterCodeGenerator::TranslateExpression(Declaration*
