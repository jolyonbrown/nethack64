 	mCodeSection = compilationUnits->mSectionCode;
 	mDataSection = compilationUnits->mSectionData;
 	mBSSection = compilationUnits->mSectionBSS;
+	mFarDefault = false;
 
 	mUnrollLoop = 0;
 	mUnrollLoopPage = false;
@@ -1412,6 +1413,7 @@ Declaration* Parser::ParsePostfixDeclaration(bool autoBase)
 		dec = new Declaration(mScanner->mLocation, DT_VARIABLE);
 		dec->mIdent = mScanner->mTokenIdent;
 		dec->mSection = mBSSection;
+		dec->mFarDefault = mFarDefault;
 		dec->mBase = nullptr;
 		mScanner->NextToken();
 
@@ -6674,6 +6676,7 @@ Declaration* Parser::ParseDeclaration(Declaration * pdec, bool variable, bool ex
 							{
 								pdec->mFlags &= ~DTF_EXTERN;
 								pdec->mSection = ndec->mSection;
+								pdec->mFarDefault = ndec->mFarDefault;
 								pdec->mSize = ndec->mSize;
 							}
 
@@ -6705,6 +6708,7 @@ Declaration* Parser::ParseDeclaration(Declaration * pdec, bool variable, bool ex
 							}
 
 							pdec->mSection = ndec->mSection;
+								pdec->mFarDefault = ndec->mFarDefault;
 
 							pdec->mFlags |= ndec->mFlags & DTF_ZEROPAGE;
 
@@ -15521,6 +15525,43 @@ void Parser::ParsePragma(void)
 
 			ConsumeToken(TK_CLOSE_PARENTHESIS);
 		}
+		else if (!strcmp(mScanner->mTokenIdent->mString, "fardefault"))
+		{
+			// #pragma fardefault(section): variables declared from here to the end of this
+			// file (or #pragma fardefault()) whose section is the default data or bss go to
+			// section instead, unless #pragma near names them (Linker::FarDefaultSection)
+			mScanner->NextToken();
+			ConsumeToken(TK_OPEN_PARENTHESIS);
+			if (mScanner->mToken == TK_IDENT)
+			{
+				LinkerSection* lsec = mCompilationUnits->mLinker->FindSection(mScanner->mTokenIdent);
+				mScanner->NextToken();
+				if (lsec && lsec->mFarSpace)
+				{
+					mCompilationUnits->mLinker->mFarDefault = lsec;
+					mFarDefault = true;
+				}
+				else
+					mErrors->Error(mScanner->mLocation, EERR_PRAGMA_PARAMETER, "Far section expected");
+			}
+			else
+				mFarDefault = false;
+			ConsumeToken(TK_CLOSE_PARENTHESIS);
+		}
+		else if (!strcmp(mScanner->mTokenIdent->mString, "near"))
+		{
+			// #pragma near(name, ...): variables that #pragma fardefault leaves near
+			mScanner->NextToken();
+			ConsumeToken(TK_OPEN_PARENTHESIS);
+			while (mScanner->mToken == TK_IDENT)
+			{
+				mCompilationUnits->mLinker->mNearIdents.Push(mScanner->mTokenIdent);
+				mScanner->NextToken();
+				if (!ConsumeTokenIf(TK_COMMA))
+					break;
+			}
+			ConsumeToken(TK_CLOSE_PARENTHESIS);
+		}
 		else if (!strcmp(mScanner->mTokenIdent->mString, "data"))
 		{
 			mScanner->NextToken();
